# ============================================================================
# Agent portal (apps/agent-portal) — agents.canvexia.com
# Copy to `.env.local`. NEVER commit real values.
#
# Same Supabase project and database as Servd and Resceta (D25): one schema,
# one set of Auth users. A Servd owner can sign in here with the same login.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Server-only. Used to roll back a half-created agent application, by the
# staff bootstrap script, and for private storage (receipts, signatures,
# contract PDFs) in the private bucket `agent-portal-private`.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

DATABASE_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-region.pooler.supabase.com:5432/postgres"

# --- This deployment ----------------------------------------------------------
# Used for the email-confirmation redirect after an agent applies.
NEXT_PUBLIC_APP_URL="https://agents.canvexia.com"

# --- Secrets ------------------------------------------------------------------
# Encrypts each product's API secret at rest (AES-256-GCM). 32 bytes.
# Generate: openssl rand -hex 32
# Its own value for this deployment — do not reuse Servd's.
CREDENTIALS_ENCRYPTION_KEY=""

# Vercel Cron sends this as a bearer token to /api/cron/*.
# Generate: openssl rand -hex 32
CRON_SECRET=""

# Signs the contract-signing links (/sign/<token>). 32+ characters.
# Generate: openssl rand -hex 32
CONTRACT_LINK_SECRET=""
