{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hnd1"
  ],
  "ignoreCommand": "npx turbo-ignore",
  "crons": [
    {
      "path": "/api/cron/events",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/callbacks",
      "schedule": "*/5 * * * *"
    }
  ]
}
