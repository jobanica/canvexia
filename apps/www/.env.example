# CANVEXIA — the public site at canvexia.com.

# --- Database ----------------------------------------------------------------
# The CANVEXIA database. Same values Servd and Resceta use — one schema and one
# database for every product (D25). The waitlist form writes through a server
# action, never from the browser, so there is no anon key here and none is
# needed: partner_waitlist and territories are locked to the system context.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-region.pooler.supabase.com:5432/postgres"

# --- Links -------------------------------------------------------------------
# "Book a call" in the nav and the hero. A Google Calendar booking page, so a
# caller picks a slot instead of joining an empty Meet room at a time nobody
# agreed — which is what the earlier meet.google.com link did.
#
# Unset hides the button rather than shipping one that goes nowhere; see
# src/lib/site.ts.
NEXT_PUBLIC_BOOKING_URL="https://calendar.app.google/CnFH1CSDhdkuh8476"

# Where the partner portal ACTUALLY answers. No domain is registered yet —
# canvexia.com, servdph.net and resceta.com are all NXDOMAIN — so this points at
# the Vercel URL of the project that serves the portal. A "Partner login" button
# aimed at a host that does not resolve is worse than no button, which is the
# rule the rest of this app follows (see src/lib/site.ts).
#
# Change to https://partner.canvexia.com/partner/login once the domain exists.
NEXT_PUBLIC_PORTAL_URL="https://canvexia-two.vercel.app/partner/login"
