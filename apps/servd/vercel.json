{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "ignoreCommand": "npx turbo-ignore",
  "crons": [
    {
      "path": "/api/cron/billing",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/cart-recovery",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/preview-cleanup",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/email-followup",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/freeze-statements",
      "schedule": "0 1 1 * *"
    },
    {
      "path": "/api/cron/partner-digest",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/partner-commissions",
      "schedule": "0 1 1 * *"
    },
    {
      "path": "/api/cron/drain-emails",
      "schedule": "*/15 * * * *"
    }
  ]
}
