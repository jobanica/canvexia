# ============================================================================
# Servd — environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit secrets.
# ============================================================================

# --- Supabase (database + auth + realtime + storage) ------------------------
# Find these in your Supabase project: Settings → API and Settings → Database.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Service-role key bypasses Row-Level Security. SERVER-ONLY. Never expose to the
# browser. Used for system tasks (webhooks, super-admin, RLS migration).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Prisma talks directly to Postgres for migrations + queries.
# Use the POOLED connection string for the app, DIRECT for migrations.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-region.pooler.supabase.com:5432/postgres"

# --- Domains (D31) -----------------------------------------------------------
#
# THREE domains, three jobs. Getting them crossed serves one brand's front page
# at another brand's address, so they are written out rather than guessed:
#
#   servdph.net   Servd — the restaurant product. Merchants get subdomains of it.
#   canvexia.com  CANVEXIA — the partner portal. Partners get subdomains of it.
#   resceta.com   Resceta — the pharmacy product. Deployed separately; see
#                 apps/resceta/.env.example. Does NOT belong in this file.
#
# servdph.com is a DIFFERENT business on a different database and is not part of
# this project. If it ever points here it is just another custom domain.

# The public address of this deployment. Everything a person sees — the
# "Powered by" badge, the QR splash, the partner support link, the outbound
# User-Agent — comes from here. Unset, they render no address and link
# relatively: a wrong domain is worse than no domain.
NEXT_PUBLIC_APP_URL="https://www.servdph.net"

# Where MERCHANT subdomains live (mango-grill.servdph.net). Leave unset for
# local dev and use *.localhost:3000.
NEXT_PUBLIC_ROOT_DOMAIN="servdph.net"

# Where PARTNER subdomains live (davao.canvexia.com). The bare root and www
# serve CANVEXIA's own front door — the partner portal, not Servd's marketing.
NEXT_PUBLIC_PARTNER_ROOT_DOMAIN="canvexia.com"

# --- Custom domains (Phase F): Vercel Domains API ---------------------------
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# Protects the billing cron endpoint. Vercel Cron sends it as a Bearer token.
# Generate: openssl rand -hex 32
CRON_SECRET=""

# --- Payments: PayMongo (Phase 9 — not used yet) ----------------------------
# Phase 1 = "connected accounts": each restaurant stores its OWN PayMongo keys
# (encrypted, on the restaurant record). These platform-level keys are only for
# platform-side testing / fallback.
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
# Key used to encrypt restaurants' stored PayMongo credentials at rest.
CREDENTIALS_ENCRYPTION_KEY=""

# --- SMS: Semaphore (post-MVP) ----------------------------------------------
# The PLATFORM holds ONE Semaphore account; usage is metered per restaurant via
# the sms_credit_ledger. Each restaurant gets its own registered sender name.
SEMAPHORE_API_KEY=""

# --- AI: Claude (Smart insights on the admin dashboard) ---------------------
# Optional. When set, the dashboard's "Smart insights" card is generated by
# Claude from the restaurant's recent analytics. Without it, the card falls
# back to built-in rule-based insights. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Optional. When set, the menu importer can generate AI food photos for items.
# Without it, the "Generate AI photos" option is hidden.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Optional. Image model: "dall-e-3" (default, ~$0.04/image, no org verification)
# or "gpt-image-1" (newer/cheaper at low quality, but the OpenAI org must be
# ID-verified at https://platform.openai.com/settings/organization/general).
OPENAI_IMAGE_MODEL="dall-e-3"
# Optional. Only for gpt-image-1: "low" (cheapest), "medium", or "high".
OPENAI_IMAGE_QUALITY="low"

# Synthetic staff logins for DIY/partner-built accounts. Never delivered to, so
# it must not be a domain somebody else owns. Derived from
# NEXT_PUBLIC_ROOT_DOMAIN when unset.
INTERNAL_LOGIN_DOMAIN="staff.servdph.net"

# Support handle or full URL shown on the public pages. Falls back to /contact.
NEXT_PUBLIC_SUPPORT_MESSENGER=""
