// ============================================================================
// Servd — data model
//
// MULTI-TENANCY: every tenant-owned table carries `restaurantId`. That column
// is the key that Row-Level Security policies (see prisma/rls.sql) filter on,
// so the database itself refuses to return another restaurant's rows.
//
// MONEY SNAPSHOTTING: orders copy the name + price of items/modifiers AT THE
// TIME OF ORDER (`*AtTime` columns). If the menu changes later, old tickets
// and receipts stay historically correct.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum StaffRole {
  kitchen
  cashier
  manager // HR / scheduling
  admin // restaurant owner/admin
  merchant // online "Incoming Orders" screen only (no full cashier UI)
}

enum RestaurantStatus {
  active
  suspended
  pending
  preview // DIY self-serve build — real data, but not a live account yet
  archived // stale preview that never activated; heavy media dropped
}

enum OrderStatus {
  pending // diner placed via QR; awaiting cashier acceptance (not yet in kitchen)
  new
  preparing
  done
  closed // settled by the cashier — leaves the active boards
  cancelled
}

enum PaymentStatus {
  unpaid
  pending
  paid
  failed
  refunded
}

enum PaymentMethod {
  online_gcash
  online_card
  cash
  card_terminal
  gcash // scanned at the counter (in person)
  maya // scanned at the counter (in person)
  bank_transfer // customer transferred to the restaurant's bank account
  /// Grab, Foodpanda and the like. Nothing is tendered at the counter — the
  /// rider collects the food and the platform remits later — so this exists to
  /// close the ticket honestly instead of ringing it up as cash nobody took.
  third_party
}

enum Gateway {
  paymongo
  xendit
  manual // cash / in-person recorded by cashier
}

enum FeedbackMode {
  on_device // prompt on the table device right after payment
  follow_up // send the review invite later via SMS
  both
}

enum PrintMethod {
  network // Wi-Fi / USB ESC/POS at a fixed station (default)
  cloud // printer polls a URL for jobs (CloudPRNT / Server Direct Print)
  bluetooth // Web Bluetooth — Chromium only, BLE ESC/POS only
  os_dialog // OS print dialog / AirPrint to HTML-PDF ticket
}

enum MarketingConsent {
  none // gave number for receipt/order only — NOT marketing permission
  pending // opted in, awaiting double-opt-in confirmation reply
  confirmed // replied YES — fully subscribed
  opted_out // replied STOP — never message again
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

// ----------------------------------------------------------------------------
// Platform-level (no restaurantId — owned by you, the super-admin)
// ----------------------------------------------------------------------------

model PlatformAdmin {
  id          String   @id @default(uuid())
  authUserId  String   @unique // FK to Supabase auth.users
  email       String   @unique
  displayName String?
  /// Back-office scope: "ops" is restricted to the pipeline sections, NULL is
  /// full access. Nullable with NO default on purpose — a default would be
  /// written into the INSERT of every admin row, and NULL already means the
  /// right thing for every admin that existed before roles did.
  role        String?
  createdAt   DateTime @default(now())

  @@map("platform_admins")
}

/// Platform-wide settings owned by the super-admin (single row, id="platform").
/// Holds the subscription billing provider + its encrypted credentials.
model PlatformSetting {
  id                String   @id @default("platform")
  billingProvider   String? // "xendit" | "paymongo" | null
  xenditCredsEnc    String? // encrypted JSON { secretKey, callbackToken }
  crmSequence       Json? // owner-edited CRM follow-up messages (overrides defaults)
  orderCapEnabled   Boolean  @default(false) // master switch for monthly order caps across all restaurants
  tutorials         Json? // course/tutorial hub content (sections + YouTube videos) shown at tutorials.<root>
  featurePrices     Json? // one-time unlock price + sellable flag per gateable feature
  uploadPostKeyEnc  String? // encrypted Upload-Post API key (social scheduling)
  emailCredsEnc     String? // encrypted JSON { apiKey, fromName, fromEmail, replyTo } for marketing email
  emailAutomationOn Boolean  @default(false) // master switch for the acquisition follow-up tracks
  /// YouTube (or Vimeo / MP4) link shown in the /create landing page's
  /// "See how easy it is" section. Empty = the section renders steps only.
  landingVideoUrl   String?
  updatedAt         DateTime @updatedAt

  @@map("platform_settings")
}

/// Feedback / recommendations from restaurant owners ABOUT Servd itself,
/// surfaced to the super-admin. Platform-level (no tenant RLS); written + read
/// through systemDb.
model PlatformFeedback {
  id             String   @id @default(uuid())
  restaurantId   String?
  restaurantName String?
  authorEmail    String?
  rating         Int? // optional 1–5
  message        String
  resolved       Boolean  @default(false)
  /// What the Servd team wrote back, shown to the owner in their own dashboard.
  ///
  /// Kept on the feedback row rather than as a thread: this is a reply to one
  /// message, and a message that has been answered is the whole state anybody
  /// needs. A conversation would need its own table and a place to hold it.
  ///
  /// Nullable with no default, and read best-effort — they ship as a hand-run
  /// migration, and an unanswered message is the normal case.
  reply          String?
  repliedAt      DateTime?
  /// When the owner saw the reply. Drives the unread dot on their sidebar.
  replyReadAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([restaurantId])
  @@map("platform_feedback")
}

/// Sales-prospecting leads: restaurants discovered via OpenStreetMap that the
/// platform owner can pursue. Platform-level (super-admin only) — never exposed
/// to tenants. `source`+`sourceId` dedupes the same place across searches.
model ProspectLead {
  id         String    @id @default(uuid())
  source     String    @default("osm") // discovery source
  sourceId   String // e.g. "node/123" — stable per place
  name       String
  address    String?
  latitude   Float?
  longitude  Float?
  phone      String?
  website    String?
  email      String?
  facebook   String?
  status     String    @default("new") // new | contacted | interested | converted | rejected
  notes      String?
  enrichedAt DateTime? // last time we scraped the website for email/FB
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([source, sourceId])
  @@index([status])
  @@index([createdAt])
  @@map("prospect_leads")
}

/// Outreach CRM (platform/super-admin only): clients you message on Facebook,
/// tracked through a follow-up sequence until they reply. Never tenant-visible.
model CrmClient {
  id               String          @id @default(uuid())
  name             String
  facebookUrl      String?
  contactName      String?
  phone            String?
  email            String?
  address          String?
  notes            String?
  stage            String          @default("new") // new | in_sequence | replied | won | lost | revisit
  step             Int             @default(0) // touches sent (0..TOTAL_TOUCHES)
  lastTouchAt      DateTime?
  nextDueAt        DateTime? // when the next follow-up is due
  repliedAt        DateTime?
  revisitAt        DateTime? // when to re-approach a no-reply prospect (revisit bucket)
  demoRestaurantId String? // the demo storefront created for this client, if any
  source           String          @default("manual")

  // --- Business-operations layer (super-admin only) ------------------------
  // Added so ONE pipeline covers both intake tracks. The manual/VA track walks
  // the stages below; a DIY signup is created already paid and skips them.
  // Every column here is nullable with no default and read best-effort: they
  // ship as a hand-run migration, and the outreach board this model already
  // drives must keep working on a database that hasn't run it.
  //
  /// The tenant this lead became, once it exists. Null while still a prospect.
  restaurantId     String?
  /// Fulfillment milestones. Null means "not reached", never "unknown date" —
  /// inventing a timestamp would quietly corrupt every funnel average.
  materialsAt      DateTime?
  productionAt     DateTime?
  previewSentAt    DateTime?
  paidAt           DateTime?
  activatedAt      DateTime?
  /// Who is working it, and why it died. Free text: the VA roster is a handful
  /// of people, and a foreign key to auth.users would be a schema change to a
  /// table this layer is forbidden from touching.
  assignedTo       String?
  lostReason       String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  touches          CrmTouch[]
  outreachVideos   OutreachVideo[]

  @@index([restaurantId])
  @@index([stage])
  @@index([nextDueAt])
  @@index([revisitAt])
  @@index([createdAt])
  @@map("crm_clients")
}

/// Personalized outreach video (super-admin only): the operator records a short
/// personalized intro on their phone (QR handoff), which is stitched with a
/// pre-baked tail into one vertical MP4 to send manually via Messenger.
model OutreachVideo {
  id                   String    @id @default(uuid())
  crmClientId          String
  status               String    @default("awaiting_recording") // awaiting_recording | uploading | rendering | ready | failed
  recordToken          String?   @unique // short-lived, single-use handoff token for the phone
  recordTokenExpiresAt DateTime?
  introPath            String? // raw phone recording (storage path)
  finalPath            String? // rendered / final MP4 (storage path)
  errorMessage         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  crmClient CrmClient @relation(fields: [crmClientId], references: [id], onDelete: Cascade)

  @@index([crmClientId])
  @@map("outreach_videos")
}

/// One logged outreach touch (initial message / follow-up) for a CRM client.
/// Immutable audit trail for the business-operations layer: every notable
/// moment in a customer's life, newest-first on their profile.
///
/// Write-only from the business's point of view — nothing reads it to decide
/// anything, which is what makes it safe to log from inside live paths. Every
/// call site is fire-and-forget: an analytics row that fails to write must
/// never be the reason an order, a payment or an activation fails.
model CustomerEvent {
  id           String   @id @default(uuid())
  /// Either or both. A DIY signup has a restaurant before it has a CRM row;
  /// an outreach prospect has a CRM row long before it has a restaurant.
  leadId       String?
  restaurantId String?
  /// lead_created | preview_sent | stage_change | payment | activation |
  /// cap_reached | upsell_offered | upsell_sold | note
  eventType    String
  /// Who did it — a super-admin email, or null when the system did.
  actor        String?
  /// Centavos, matching every other money column in the schema. Null when the
  /// event isn't a payment.
  amount       Int?
  meta         Json?
  occurredAt   DateTime @default(now())

  @@index([restaurantId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("customer_events")
}

/// Manual ad-spend entry, so cost per lead and CAC have a real numerator.
///
/// Typed in by hand rather than pulled from Facebook: this layer never holds a
/// third-party credential, and a founder who spends on three platforms would
/// have to reconcile them by hand anyway. Super-admin only.
model AdSpend {
  id        String   @id @default(uuid())
  /// The day the spend belongs to, Manila. Stored as a date-only midnight.
  spendDate DateTime
  platform  String   @default("facebook")
  campaign  String?
  /// Centavos, like every other money column in this schema.
  amount    Int
  createdAt DateTime @default(now())

  @@index([spendDate])
  @@map("ad_spend")
}

model CrmTouch {
  id        String    @id @default(uuid())
  clientId  String
  client    CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  step      Int
  channel   String    @default("facebook")
  label     String?
  createdAt DateTime  @default(now())

  @@index([clientId, createdAt])
  @@map("crm_touches")
}

// ----------------------------------------------------------------------------
// Content Engine (platform/super-admin only): Taglish short-form video scripts
// for Servd's OWN marketing, built on the Jab-Jab-Jab-Right-Hook framework.
// Internal tool — never tenant-visible. All access via systemDb + RLS super_only.
// ----------------------------------------------------------------------------

enum ContentPillarKind {
  JAB
  RIGHT_HOOK
}

enum ContentScriptStatus {
  IDEA
  SCRIPTED
  FILMED
  POSTED
}

/// The brand voice + framework config the generator follows. One row ("Servd").
model ContentBrandProfile {
  id           String   @id @default(cuid())
  name         String   @default("Servd")
  systemPrompt String // editable brand/voice prompt
  jabRatio     Int      @default(3) // jabs per 1 right hook — configurable
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pillars ContentPillar[]
  scripts ContentScript[]

  @@map("content_brand_profiles")
}

/// A content theme. Jabs give value; right hooks make the ask.
model ContentPillar {
  id          String              @id @default(cuid())
  brandId     String
  brand       ContentBrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)
  kind        ContentPillarKind
  name        String
  description String
  active      Boolean             @default(true)
  scripts     ContentScript[]

  @@index([brandId])
  @@map("content_pillars")
}

/// A generated (or hand-edited) short-form video script.
model ContentScript {
  id           String              @id @default(cuid())
  brandId      String
  brand        ContentBrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)
  pillarId     String?
  pillar       ContentPillar?      @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  type         ContentPillarKind
  platform     String // "reels" | "tiktok" | "facebook"
  lengthSec    Int
  title        String
  hook         Json // { visual, audio, textOverlay }
  body         Json // [{ time, action, line }]
  cta          Json? // { verbal, text, action } | null (null for jabs)
  production   Json // { music, bRoll, graphics }
  status       ContentScriptStatus @default(IDEA)
  saves        Int?
  shares       Int?
  dms          Int?
  postedAt     DateTime?
  scheduledFor DateTime?
  createdById  String? // platform admin id/email, if known
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([brandId, createdAt])
  @@index([status])
  @@map("content_scripts")
}

/// Per-call generation log for cost visibility (token spend) + the daily cap.
model ContentGenerationLog {
  id           String   @id @default(cuid())
  brandId      String?
  model        String
  mode         String // "single" | "batch"
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  scriptId     String?
  ok           Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("content_generation_logs")
}

model Plan {
  id           String   @id @default(uuid())
  name         String
  priceMonthly Int // store money in centavos (integers) to avoid float errors
  limits       Json // e.g. { maxTables, maxStaff, smsIncluded }
  features     String[] @default([]) // gateable feature keys this plan grants (super-admin controlled)
  trialDays    Int      @default(30) // free-trial length for new signups
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurants   Restaurant[]
  subscriptions Subscription[]
  modules       PlanModule[]

  @@map("plans")
}

enum PlanModuleType {
  hris
  inventory
  custom_domain
}

// Which optional add-on modules a plan unlocks. Read by the entitlements helper
// that F/G/H gate on. Platform-level reference data (no restaurant_id).
model PlanModule {
  planId  String
  module  PlanModuleType
  enabled Boolean        @default(true)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, module])
  @@map("plan_modules")
}

// ----------------------------------------------------------------------------
// Tenant root
// ----------------------------------------------------------------------------

model Restaurant {
  id            String           @id @default(uuid())
  name          String
  slug          String           @unique // used in /order/{slug}/{tableToken}
  /// The address this shop used BEFORE the owner corrected it.
  ///
  /// Changing a slug rewrites the web address printed on every table QR in the
  /// building and shared in every post the shop has ever made. Keeping the old
  /// one here lets those keep working: the public lookup falls back to it, so a
  /// tent card printed last year still opens the right menu.
  ///
  /// Nullable with no default — it ships as a hand-run migration, and it is
  /// genuinely absent for the overwhelming majority of shops.
  previousSlug  String?          @unique
  status        RestaurantStatus @default(pending)
  planId        String?
  // Set when a partner creates this as a DEMO storefront (no login) to pitch a
  // prospect. Null for real tenants + super-admin demos.
  demoPartnerId String?
  // When a partner ran the AI menu scan on this storefront. One scan per demo:
  // it's an AI vision call billed to us, and a partner opens unlimited demos.
  // Nullable with NO default — a static default would be sent by Prisma on
  // every insert and break creates on a database that lacks the column.
  // Deliberately a timestamp rather than a boolean: "when" answers questions a
  // flag can't, and reads as false when null either way.
  menuScannedAt DateTime?

  // --- White-label branding (defaults give a clean "Servd look") ---
  displayName       String?
  logoUrl           String?
  brandPrimaryColor String? // null => inherit Servd default
  brandAccentColor  String?
  coverImageUrl     String?
  tagline           String?
  // Plan-banner override (super-admin): "legacy" hides the banner entirely,
  // "lite" marks the hidden 300-order save offer. null → derive from the plan.
  bannerPlan        String?

  // --- Business location (set by super-admin at creation; shown on the
  // super-admin map so they can visit the business) ---
  businessAddress String?
  latitude        Float?
  longitude       Float?

  // --- Claim flow: created by super-admin with no login; the owner opens the
  // claim link to set their email + password. Token cleared once claimed. ---
  claimToken String?   @unique
  claimedAt  DateTime?

  // --- Reputation ---
  googleReviewUrl String?
  feedbackMode    FeedbackMode @default(follow_up)

  // --- Printing ---
  printMethod      PrintMethod @default(network)
  printerConfig    Json? // transport-specific details (ip, port, cloudprnt url…)
  autoPrint        Boolean     @default(false)
  // Print a receipt automatically when a payment settles. Default on, because
  // that was the only behaviour before this was a choice — but a till whose
  // customers don't want paper was burning a roll a day with no way to stop it.
  //
  // The default is dbgenerated rather than a plain `@default(true)`, and that
  // is load-bearing for every column added after this line too. A plain default
  // is applied by PRISMA: it puts the column into the INSERT of every
  // restaurant.create() in the codebase, whether or not the caller mentioned
  // it. On a live database that hasn't run the matching file in prisma/manual
  // yet, that turns a brand-new column into "cannot create a restaurant at
  // all" — creating a storefront died on `qrGrandfathered` exactly this way.
  // Handing the default to the database instead means Prisma never names the
  // column, so a create keeps working right through the migration lag and the
  // column starts carrying its default the moment the SQL is run.
  autoPrintReceipt Boolean     @default(dbgenerated("true"))
  // When to pop the cash drawer: never | cash (cash payments only) | any.
  // A card or GCash sale puts nothing in the drawer, so "cash" is the default —
  // but a till that gives change for e-wallets can choose "any".
  openDrawerOn     String      @default(dbgenerated("'cash'"))
  cashierVoidPin   String? // PIN a cashier must enter to void an unpaid order
  // Kitchen routing: true => on-screen kitchen display; false => print a kitchen
  // ticket for the kitchen when an order is accepted/created (no screen).
  kitchenDisplay   Boolean     @default(true)

  // --- Payments (connected-accounts model) ---
  // Each restaurant stores its OWN PayMongo credentials, encrypted at rest.
  paymentGateway        Gateway? // null until they connect a gateway
  paymentCredentialsEnc String? // encrypted blob — never stored in plaintext
  paymentOnlineEnabled  Boolean  @default(false)

  // --- SMS (post-MVP) ---
  smsSenderName    String?
  smsCreditBalance Int     @default(0)
  // Default to double opt-in (confirmation reply required); single is a fallback.
  smsDoubleOptIn   Boolean @default(true)

  // Premium custom-domain tier (gated by the custom_domain plan module).
  uploadPostUser         String?   @unique // Upload-Post profile username for social scheduling
  subdomain              String?   @unique
  customDomain           String?   @unique
  customDomainVerifiedAt DateTime?

  // Self-serve onboarding: null until the owner finishes/dismisses the wizard.
  onboardingCompletedAt DateTime?

  // --- DIY self-serve builder (public, no-login funnel at /build) ---
  // A DIY build starts as status=preview and only becomes a real account once
  // the ₱499 activation invoice is paid (verified by the Xendit webhook).
  buildToken            String?   @unique // capability token: lets an anon builder return to edit
  builtVia              String    @default("manual") // "diy" | "manual"
  contactEmail          String? // lead capture — required on a DIY build (email marketing)
  contactPhone          String?
  contactFb             String?
  /// The Facebook post showing this prospect their preview storefront. Kept
  /// apart from contactFb, which is how to REACH them and feeds the follow-up
  /// list — a post link there would break chasing them.
  previewPostUrl        String?
  emailOptOut           Boolean   @default(false) // unsubscribed from platform marketing email
  unsubToken            String?   @unique // one-click unsubscribe link, no login needed
  previewCreatedAt      DateTime? // build started
  previewReachedAt      DateTime? // first time they saw their own storefront
  activationRequestedAt DateTime? // tapped "Activate" (invoice created)

  // Which ad brought them, captured at /create and stamped on at first save.
  // Kept on the lead itself so an activation can be traced back to a creative —
  // the only number that decides where the ad budget goes.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?

  // Language the base menu text was written in (the i18n fallback).
  defaultLocale String @default("en")

  // Inventory: auto-flip a menu item to out-of-stock when an ingredient hits 0.
  autoOutOfStock     Boolean @default(false)
  /// Kept unlimited tables/QRs from before that became a paid unlock. Set once,
  /// by the migration, for every account that already existed — never for a new
  /// one. Changing the rules on people who already built their floor plan
  /// around them is not a thing we do.
  ///
  /// dbgenerated, not `@default(false)` — see the note above `autoPrintReceipt`.
  qrGrandfathered    Boolean @default(dbgenerated("false"))
  lowStockAlertPhone String? // phone to SMS when an ingredient drops to its reorder level

  // --- Loyalty & rewards (points per peso) ---
  loyaltyEnabled       Boolean @default(false)
  loyaltyPesosPerPoint Int     @default(20) // ₱ spent to earn 1 point
  loyaltyPointValue    Int     @default(100) // centavos a point is worth on redeem

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan               Plan?                 @relation(fields: [planId], references: [id])
  staff              StaffUser[]
  subscriptions      Subscription[]
  tables             Table[]
  categories         Category[]
  menuItems          MenuItem[]
  modifierGroups     ModifierGroup[]
  orders             Order[]
  printJobs          PrintJob[]
  cashierShifts      CashierShift[]
  feedback           Feedback[]
  promotions         Promotion[]
  customers          CustomerContact[]
  smsCampaigns       SmsCampaign[]
  auditLogs          AuditLog[]
  happyHours         HappyHour[]
  giftCards          GiftCard[]
  reservations       Reservation[]
  cartLeads          CartLead[]
  shiftNotes         ShiftNote[]
  smsCreditLedger    SmsCreditLedger[]
  invoices           RestaurantInvoice[]
  addonPurchases     AddonPurchase[]
  activationRequests ActivationRequest[]
  emailSends         EmailSend[]
  payrollDeductions  PayrollDeduction[]
  socialPosts        SocialPost[]
  featureSubs        FeatureSubscription[]
  suppliers          Supplier[]
  inventoryItems     InventoryItem[]
  purchaseOrders     PurchaseOrder[]
  employees          Employee[]
  loyaltyAccounts    LoyaltyAccount[]
  loyaltyTxns        LoyaltyTransaction[]
  expenses           Expense[]
  payrollSetting     PayrollSetting?
  menuItemCosts      MenuItemCost[]
  storefront         StorefrontSetting?
  pushSubscriptions  PushSubscription[]

  @@index([demoPartnerId])
  @@map("restaurants")
}

/// Web Push subscriptions for merchant devices — lets a new online order alert
/// the phone even when the Incoming Orders app is minimized or closed.
model PushSubscription {
  id           String   @id @default(uuid())
  restaurantId String
  /// Set when a diner subscribed from their own order tracker rather than a
  /// merchant subscribing their till. Merchant sends match on restaurantId and
  /// ignore this; a diner send matches on it alone, so the two never cross.
  orderId      String?
  endpoint     String   @unique
  p256dh       String // subscription public key
  auth         String // subscription auth secret
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([orderId])
  @@map("push_subscriptions")
}

/// Public website settings: store hours + delivery zones/fees.
model StorefrontSetting {
  id              String   @id @default(uuid())
  restaurantId    String   @unique
  hours           Json? // [{open,close,closed}] index 0=Sun … 6=Sat
  deliveryZones   Json? // [{name, fee}] fee in centavos
  pauseWhenClosed Boolean  @default(false) // block online orders outside hours
  /// Manual "stop taking online orders" switch, for when the kitchen is buried.
  ///
  /// Separate from pauseWhenClosed, which is automatic and tied to opening
  /// hours. This one is the owner deciding, right now, regardless of the clock
  /// — and it has to be flipped back by hand, which is the point: it should
  /// never quietly turn itself on again mid-service.
  ///
  /// Nullable with NO default: a static default would be sent by Prisma on
  /// every insert and break saving storefront settings on a database that
  /// lacks the column. Null means not paused.
  ordersPaused    Boolean?
  /// Accept an online order by itself if nobody has answered it within this
  /// many seconds. Null or 0 means off, which is how every shop behaves until
  /// somebody turns it on.
  ///
  /// Seconds rather than a boolean so the wait is the shop's decision: a busy
  /// counter wants ten, a kitchen that genuinely vets every order wants a
  /// minute or nothing at all.
  ///
  /// Nullable with NO default, like ordersPaused above and for the same
  /// reason: a static default is a value Prisma writes into the INSERT of every
  /// storefront_settings row, which breaks saving settings on a database that
  /// has not run the migration.
  autoAcceptSeconds Int?
  acceptsBookings Boolean  @default(false) // show the "Book a table" flow on the website
  bookingConfig   Json? // { requireDownpayment, downpaymentType, downpaymentValue, downpaymentInstructions }
  paymentConfig   Json? // { codEnabled, gcashEnabled, gcashName, gcashNumber, gcashQrUrl }
  deliveryConfig  Json? // { mode, baseFee, perKm, freeKm, minFee, maxKm, roadFactor, originLat, originLng }

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("storefront_settings")
}

/// Customizable statutory payroll deductions per restaurant (PH).
model PayrollSetting {
  id               String  @id @default(uuid())
  restaurantId     String  @unique
  sssAmount        Int     @default(0) // fixed centavos per pay period (employee share)
  philhealthAmount Int     @default(0)
  pagibigAmount    Int     @default(0)
  birAmount        Int     @default(0)
  thirteenthMonth  Boolean @default(false) // accrue 1/12 of base

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("payroll_settings")
}

/// Food cost per menu item (for accounting COGS). Stored separately so adding it
/// never affects the hot menu read paths.
model MenuItemCost {
  id           String @id @default(uuid())
  restaurantId String
  menuItemId   String @unique
  cost         Int    @default(0) // centavos per item

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("menu_item_costs")
}

/// A business expense for the accounting section (rent, supplies, payroll, …).
model Expense {
  id           String   @id @default(uuid())
  restaurantId String
  date         DateTime
  category     String
  amount       Int // centavos
  note         String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, date])
  @@map("expenses")
}

/// A cash drawer movement — currently used for cash-outs (money removed from
/// the drawer, e.g. the owner taking cash). Kept separate from expenses so it
/// doesn't distort the P&L; it only affects expected cash in the drawer.
model CashMovement {
  id           String   @id @default(uuid())
  restaurantId String
  type         String   @default("cash_out") // cash_out (future: cash_in / float)
  amount       Int // centavos
  note         String?
  staffEmail   String? // who recorded it
  shiftId      String? // the cashier shift it came out of
  createdAt    DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([shiftId])
  @@map("cash_movements")
}

/// One cashier's turn at the till.
///
/// Opened the first time they act on the cashier screen, closed by "End shift"
/// (which prints the Z-report and signs them out). Every payment and cash-out
/// they take is stamped with it, so the summary counts THEIR drawer rather than
/// the whole restaurant's day — the previous behaviour, where a cashier saw the
/// takings of everyone before them, is what made separate logins pointless.
///
/// A stale shift (browser closed, session expired) is auto-closed at the start
/// of the next business day rather than carrying over.
model CashierShift {
  id           String    @id @default(uuid())
  restaurantId String
  staffUserId  String
  /// Snapshot of the name, so a renamed or deleted login keeps its Z-report.
  staffName    String
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  status       String    @default("open") // open | closed
  closedReason String? // ended | auto_end_of_day

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([restaurantId, staffUserId, openedAt])
  @@map("cashier_shifts")
}

/// A customer's loyalty balance at a restaurant, keyed by phone number.
model LoyaltyAccount {
  id           String   @id @default(uuid())
  restaurantId String
  phone        String
  name         String?
  points       Int      @default(0)
  totalEarned  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, phone])
  @@map("loyalty_accounts")
}

/// An audit trail of points earned / redeemed / adjusted.
model LoyaltyTransaction {
  id           String   @id @default(uuid())
  restaurantId String
  phone        String
  orderId      String?
  points       Int // signed: + earned, - redeemed
  kind         String // earn | redeem | adjust
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, phone])
  @@map("loyalty_transactions")
}

model StaffUser {
  id           String    @id @default(uuid())
  restaurantId String
  // Authentication is handled by Supabase Auth (passwords live in auth.users,
  // hashed + salted by Supabase). We DON'T roll our own password storage.
  // NOT globally unique: one login can be staff at several restaurants, which
  // is how an owner runs multiple branches from a single account. Unique per
  // restaurant instead, so they still can't hold two roles in the same shop.
  authUserId   String
  role         StaffRole
  email        String
  username     String?   @unique // optional login handle (super-admin can create by username)
  displayName  String?
  /// Set only on a throwaway login made to demo a storefront to a prospect.
  /// Carrying an expiry IS what makes it temporary — there is no second boolean
  /// to fall out of step with it. NULL on every real staff account, which is
  /// what the conversion check and the staff list both rely on.
  previewExpiresAt DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, email])
  @@unique([restaurantId, authUserId])
  @@index([restaurantId])
  // Every request resolves the session by authUserId, so this one is hot.
  @@index([authUserId])
  @@map("staff_users")
}

model Subscription {
  id                      String             @id @default(uuid())
  restaurantId            String // current subscription is the latest row; app keeps one active
  planId                  String
  status                  SubscriptionStatus @default(trialing)
  trialEndsAt             DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean            @default(false)
  // Dunning: how many consecutive charge attempts have failed.
  failedCharges           Int                @default(0)
  // Gateway refs for off-session recurring charges (platform's PayMongo account).
  providerCustomerId      String?
  providerPaymentMethodId String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       Plan       @relation(fields: [planId], references: [id])

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model RestaurantInvoice {
  id           String    @id @default(uuid())
  restaurantId String
  amount       Int // centavos
  status       String    @default("open") // open | paid | failed | void
  periodStart  DateTime
  periodEnd    DateTime
  providerRef  String? // gateway payment-intent id
  paidAt       DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("restaurant_invoices")
}

/// A per-feature MONTHLY subscription (e.g. the content scheduler at ₱499/mo).
/// Separate from the plan and from one-time AddonPurchases: access is granted
/// only while `status` is active and `currentPeriodEnd` is still in the future,
/// so a trial never unlocks it and the first month must be paid up front.
model FeatureSubscription {
  id               String    @id @default(uuid())
  restaurantId     String
  feature          String // gateable feature key, e.g. "contentScheduler"
  status           String    @default("pending") // pending | active | past_due | cancelled
  priceMonthly     Int // centavos, snapshotted at purchase
  currentPeriodEnd DateTime?
  providerRef      String?   @unique // latest gateway checkout/invoice id
  renewUrl         String? // hosted checkout for the pending renewal, if any
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, feature])
  @@index([status, currentPeriodEnd])
  @@map("feature_subscriptions")
}

/// A social post composed in the app and published/scheduled through
/// Upload-Post. `providerRef` is the request id it returns, so a post can be
/// traced back to the provider.
model SocialPost {
  id           String    @id @default(uuid())
  restaurantId String
  caption      String
  mediaUrl     String? // uploaded image; null = text-only post
  platforms    String // comma-separated: "facebook,instagram"
  scheduledFor DateTime? // null = published immediately
  status       String    @default("scheduled") // scheduled | posted | failed
  providerRef  String? // Upload-Post request_id
  error        String?
  postedAt     DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, scheduledFor])
  @@map("social_posts")
}

/// A ONE-TIME add-on a restaurant buys from Servd (currently the custom-domain
/// unlock for Free/trial accounts). Deliberately separate from
/// RestaurantInvoice: paying one of these must never activate or extend a
/// subscription, only grant the add-on.
model AddonPurchase {
  id           String    @id @default(uuid())
  restaurantId String
  addon        String // "custom_domain"
  amount       Int // centavos
  status       String    @default("pending") // pending | paid | failed
  providerRef  String?   @unique // gateway invoice/checkout id
  paidAt       DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, addon])
  @@map("addon_purchases")
}

/// One "activate my DIY preview for ₱499" attempt. The Xendit invoice's
/// external_id is this row's id, so the verified webhook knows exactly which
/// preview to turn into a real account. Rows are never deleted — an abandoned
/// one is the founder's warm-lead follow-up list.
model ActivationRequest {
  id            String    @id @default(uuid())
  restaurantId  String
  status        String    @default("pending") // pending | paid | activated | abandoned
  amount        Int       @default(49900) // centavos
  contactPhone  String?
  contactFb     String?
  note          String?
  providerRef   String?   @unique // Xendit invoice id — the idempotency key
  checkoutUrl   String? // hosted Xendit invoice URL (so we can re-offer it)
  /// Username of the login created on activation. The PASSWORD is never stored:
  /// the owner sets their own through the one-time claim link.
  loginUsername String?
  paidAt        DateTime?
  activatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([restaurantId])
  @@map("activation_requests")
}

/// One marketing email blast to a segment of leads. Platform-level: the
/// audience is restaurants (owners who built a preview), not their diners —
/// per-restaurant customer messaging is the SMS campaign system.
model EmailCampaign {
  id         String    @id @default(uuid())
  subject    String
  body       String // plain text with {{name}} merge tags
  segment    String // audience key — see server/email/audience.ts
  status     String    @default("draft") // draft | sending | sent | failed
  recipients Int       @default(0)
  sent       Int       @default(0)
  failed     Int       @default(0)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  messages EmailMessage[]

  @@index([status, createdAt])
  @@map("email_campaigns")
}

/// One recipient of one campaign. Kept after sending so a re-send can skip
/// anyone who already got it, and so failures are visible rather than silent.
model EmailMessage {
  id           String    @id @default(uuid())
  campaignId   String
  restaurantId String?
  email        String
  status       String    @default("queued") // queued | sent | failed
  error        String?
  providerRef  String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@map("email_messages")
}

/// Editable copy for one step of an acquisition track. The SEQUENCE (which
/// steps exist and when they land) is fixed in lib/email/tracks.ts; only the
/// words and the on/off switch live here, so a founder can rewrite a subject
/// line without being able to accidentally reshape the funnel.
model EmailTemplate {
  id        String   @id @default(uuid())
  stepKey   String   @unique // "A_immediate", "B_day3", …
  subject   String
  body      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

/// One scheduled email to one lead. Rows are written the moment someone enters
/// a track, so the whole sequence is visible before any of it goes out — and
/// the unique pair means a step can never be scheduled, or sent, twice.
model EmailSend {
  id           String    @id @default(uuid())
  restaurantId String
  track        String // "A" | "B"
  stepKey      String
  sendAt       DateTime
  /// Stamped when a run CLAIMS the row, then again on success — so while the
  /// status is `sending` this doubles as "when did a pass take this", which is
  /// how a crashed run's rows get recovered.
  sentAt       DateTime?
  /// scheduled → sending → sent, or back to scheduled on a retryable failure.
  status       String    @default("scheduled") // scheduled | sending | sent | skipped | failed
  skipReason   String? // activated | unsubscribed | moved_to_B | disabled | …
  attempts     Int       @default(0)
  error        String?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, stepKey])
  @@index([status, sendAt])
  @@index([restaurantId])
  @@map("email_sends")
}

/// Fixed-window counter for unauthenticated endpoints (the public builder).
/// Platform-level: no tenant owns it, and it's only ever touched by systemDb.
model RateLimit {
  id       String   @id @default(uuid())
  bucket   String // "build:create", "build:upload", …
  key      String // hashed client IP — never the raw address
  windowAt DateTime // start of the fixed window
  count    Int      @default(0)

  @@unique([bucket, key, windowAt])
  @@index([windowAt])
  @@map("rate_limits")
}

/// Landing-page counters for the ad funnel: views and CTA clicks on /create,
/// per Manila day and per UTM combination.
///
/// Aggregated rather than one row per hit — an ad campaign generates a lot of
/// views, and none of them are individually interesting. The empty string, not
/// NULL, marks a missing tag: Postgres treats NULLs as distinct in a unique
/// index, which would silently split one campaign's counter into many rows.
model LandingStat {
  id       String @id @default(uuid())
  day      String // "YYYY-MM-DD" in Manila
  event    String // "view" | "cta"
  source   String @default("")
  medium   String @default("")
  campaign String @default("")
  content  String @default("")
  count    Int    @default(0)

  @@unique([day, event, source, medium, campaign, content])
  @@index([day])
  @@map("landing_stats")
}

// ----------------------------------------------------------------------------
// Partner program
// ----------------------------------------------------------------------------
//
// This used to be an affiliate scheme in two tracks: a restaurant that referred
// another restaurant earned account credit (Track 1), and a platform partner
// earned a recurring percentage of the subscriptions they brought in (Track 2),
// with milestone bonuses, payout batches, clawbacks and withholding on top.
//
// None of that exists any more. A partner sets restaurants up themselves, as
// many as they like, and bills those restaurants directly at whatever price
// they agree; Servd never sees that price and never takes or pays a share. So
// there is nothing to attribute, accrue, claw back or pay out, and the tables
// that existed only to track money moving between us and a partner are gone:
// referral_codes, referrals, referral_events, commissions, payouts,
// partner_bonuses and account_credits.
//
// Dropping the tables themselves is optional and destructive — see
// prisma/manual/drop-referral-program.sql. Nothing reads them, so leaving them
// in place is harmless.

/// A platform partner. Has its own login (Supabase auth) and can set up an
/// unlimited number of restaurants, which they bill directly.
model Partner {
  id               String   @id @default(uuid())
  authUserId       String?  @unique // Supabase auth user for the partner portal
  name             String
  email            String   @unique
  status           String   @default("pending") // pending | approved | suspended | rejected
  tier             String   @default("reseller") // "affiliate" survives only on old rows
  // Payout/tax columns from the commission era. Servd pays partners nothing, so
  // new applications never fill these in; they stay only to preserve what was
  // already collected. Nothing reads them.
  payoutMethod     String?
  payoutDetailsEnc String?
  taxInfoEnc       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("partners")
}

/// Program-wide settings (singleton row id="program").
///
/// Once carried the commission rates, bonus tiers, cookie window, clawback
/// window, minimum payout and withholding %. All of that went with the
/// commission; the training video is the only setting left. The columns still
/// exist in the database (NOT NULL with defaults, so inserts here are fine) —
/// the optional drop script clears them out.
model ProgramSetting {
  id                 String   @id @default("program")
  /// Partner onboarding video shown on the partner dashboard. A YouTube/Vimeo
  /// link or a direct video URL (super-admin sets it).
  partnerTrainingUrl String?
  updatedAt          DateTime @updatedAt

  @@map("program_settings")
}

// ----------------------------------------------------------------------------
// Tables & menu
// ----------------------------------------------------------------------------

enum TableStatus {
  empty
  occupied
  needs_cleaning
  reserved
}

model Table {
  id           String      @id @default(uuid())
  restaurantId String
  tableNumber  String // string so "T1", "Patio-3" etc. are allowed
  qrToken      String      @unique // non-guessable token embedded in the QR
  isCounter    Boolean     @default(false) // a single stall/takeout QR — issues order numbers, not a seat
  status       TableStatus @default(empty) // floor-plan status (occupancy is also derived from open orders)
  posX         Int? // floor-plan layout position
  posY         Int?
  seats        Int? // capacity (optional, used by reservations)
  createdAt    DateTime    @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
  @@map("tables")
}

/// Immutable audit trail — every sensitive change (voids, edits, discounts,
/// status overrides) records who/what/when with before/after snapshots.
model AuditLog {
  id           String   @id @default(uuid())
  restaurantId String
  actorStaffId String? // StaffUser.id of who did it (null = system)
  actorEmail   String? // snapshot of the actor's email for display
  action       String // e.g. "order.void", "order.item_void", "table.status"
  entityType   String // "order", "table", "order_item", …
  entityId     String?
  reason       String? // mandatory reason code/text for approvals
  before       Json? // snapshot before the change
  after        Json? // snapshot after the change
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@index([restaurantId, entityType, entityId])
  @@map("audit_logs")
}

model Category {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]
  translations CategoryTranslation[]

  @@index([restaurantId])
  @@map("categories")
}

model CategoryTranslation {
  id           String @id @default(uuid())
  restaurantId String
  categoryId   String
  locale       String // e.g. "fil"
  name         String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([restaurantId])
  @@map("category_translations")
}

model MenuItem {
  id             String   @id @default(uuid())
  restaurantId   String // denormalized for RLS + simple tenant scoping
  categoryId     String
  name           String
  description    String?
  price          Int // centavos
  imageUrl       String?
  videoUrl       String? // uploaded file URL or a YouTube/Vimeo/direct link
  videoPosterUrl String? // optional poster; UI falls back to imageUrl
  isAvailable    Boolean  @default(true) // false => out of stock
  /// Counter-only: the cashier can punch it, the website never shows it and
  /// the diner order builder refuses it. For the things a menu shouldn't
  /// advertise but a till still has to ring up — a takeaway box charged by
  /// size, an add-on somebody wants three of, a staff meal, a dessert that
  /// doesn't survive a delivery ride.
  ///
  /// Nullable with no default: it ships as a hand-run migration, and a
  /// defaulted column would go into the INSERT of every menu item created
  /// before that migration is run. Treat null as false.
  posOnly        Boolean?
  dietaryTags    String[] @default([]) // diet/allergen tag keys (see src/lib/menu/dietary.ts)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  restaurant       Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category         Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups   MenuItemModifierGroup[]
  orderItems       OrderItem[]
  translations     MenuItemTranslation[]
  recipeComponents RecipeComponent[]
  foodCost         MenuItemCost?
  serving          MenuItemServing?
  variants         MenuItemVariant[]
  stock            InventoryItem? // present when this product's own units are counted

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

// Per-item sizes/variants (e.g. fish/pork sold by size or weight): one item with
// several named options, each its own absolute price (centavos). The chosen
// variant replaces the item's base price — separate from modifiers. Own table so
// existing menu_items reads stay safe on a lagging DB.
model MenuItemVariant {
  id           String   @id @default(uuid())
  restaurantId String
  menuItemId   String
  name         String // "Small", "1/2 kilo", "Large", …
  price        Int // absolute price in centavos
  stock        Int? // pcs available for this size; null = untracked, 0 = sold out
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@index([restaurantId])
  @@map("menu_item_variants")
}

// Per-item daily servings cap (e.g. "only 5 of these per day"). Lives in its own
// table so existing menu_items reads stay safe on a lagging DB. `soldToday` is
// reset lazily against `soldOn` (the Manila day key) when counted.
model MenuItemServing {
  menuItemId   String   @id
  restaurantId String
  dailyLimit   Int? // null = unlimited (no cap)
  soldToday    Int      @default(0)
  soldOn       String? // Manila day key (YYYY-MM-DD) the count belongs to
  updatedAt    DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("menu_item_servings")
}

model MenuItemTranslation {
  id           String  @id @default(uuid())
  restaurantId String
  menuItemId   String
  locale       String
  name         String
  description  String?

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, locale])
  @@index([restaurantId])
  @@map("menu_item_translations")
}

model ModifierGroup {
  id           String   @id @default(uuid())
  restaurantId String
  name         String // "Size", "Add-ons", "Spice level"
  required     Boolean  @default(false)
  minSelect    Int      @default(0)
  maxSelect    Int      @default(1) // 1 => single-select, >1 => multi-select
  /// The order these appear in, everywhere, for every item that uses them.
  ///
  /// Set once on the Modifiers page. Without it the order came off the
  /// item↔group link, whose sortOrder was never written — so every row tied at
  /// 0 and Postgres returned them in whatever order it liked, which is why one
  /// item asked Size → Flavour → Add-ons and the next asked Flavour → Add-ons
  /// → Size.
  ///
  /// Nullable with NO default: a static default would be sent by Prisma on
  /// every insert and break creates on a database that lacks the column. Null
  /// sorts last, behind everything explicitly ordered.
  sortOrder    Int?
  createdAt    DateTime @default(now())

  restaurant Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  modifiers  Modifier[]
  menuItems  MenuItemModifierGroup[]

  @@index([restaurantId])
  @@map("modifier_groups")
}

model Modifier {
  id              String  @id @default(uuid())
  modifierGroupId String
  name            String // "Large", "Extra cheese"
  priceDelta      Int     @default(0) // centavos; +30, +20, can be negative
  sortOrder       Int     @default(0)
  isAvailable     Boolean @default(true) // false = marked out (add-on ran out)

  group ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@index([modifierGroupId])
  @@map("modifiers")
}

// join: which modifier groups apply to which menu item
model MenuItemModifierGroup {
  menuItemId      String
  modifierGroupId String
  sortOrder       Int    @default(0)

  menuItem MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  group    ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
  @@map("menu_item_modifier_groups")
}

// ----------------------------------------------------------------------------
// Inventory module (plan-gated by `inventory`)
// ----------------------------------------------------------------------------

enum StockReason {
  sale // auto-deducted when an order is marked done
  waste
  received // from a purchase order
  adjustment // manual correction
  count // reconciled by a stock count
  usage // manually taken/requested for use (prep, staff meal, etc.)
}

enum PurchaseOrderStatus {
  draft
  ordered
  received
  cancelled
}

model Supplier {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  contactJson  Json?
  createdAt    DateTime @default(now())

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]

  @@index([restaurantId])
  @@map("suppliers")
}

model InventoryItem {
  id                String    @id @default(uuid())
  restaurantId      String
  name              String
  unit              String // "kg", "pc", "ml", …
  stockQty          Float     @default(0)
  costPerUnit       Int       @default(0) // centavos (weighted-average)
  reorderLevel      Float     @default(0)
  lowStockAlertedAt DateTime? // set when a low-stock alert was sent; cleared on restock
  supplierId        String?
  // Set => this row IS a product's own stock, not an ingredient. A restaurant
  // tracks flour and sells dishes made from it; a shop tracks the thing it
  // sells. Both are stock, so both live here and share movements, costing,
  // purchase orders and reorder alerts — the link is what tells them apart.
  menuItemId        String?   @unique
  createdAt         DateTime  @default(now())

  restaurant       Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier         Supplier?           @relation(fields: [supplierId], references: [id])
  menuItem         MenuItem?           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  movements        StockMovement[]
  recipeComponents RecipeComponent[]
  poItems          PurchaseOrderItem[]

  @@index([restaurantId])
  @@map("inventory_items")
}

model RecipeComponent {
  id              String @id @default(uuid())
  restaurantId    String
  menuItemId      String
  inventoryItemId String
  quantity        Float // amount consumed per 1 of the menu item

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, inventoryItemId])
  @@index([restaurantId])
  @@map("recipe_components")
}

model StockMovement {
  id              String      @id @default(uuid())
  restaurantId    String
  inventoryItemId String
  changeQty       Float // negative = consumed, positive = added
  reason          StockReason
  unitCost        Int? // cost/unit at the time (centavos) — for COGS
  refId           String? // orderId / purchaseOrderId / etc.
  note            String?
  createdAt       DateTime    @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@index([inventoryItemId])
  @@map("stock_movements")
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  restaurantId String
  supplierId   String?
  status       PurchaseOrderStatus @default(draft)
  createdAt    DateTime            @default(now())
  receivedAt   DateTime?

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier   Supplier?           @relation(fields: [supplierId], references: [id])
  items      PurchaseOrderItem[]

  @@index([restaurantId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(uuid())
  restaurantId    String
  purchaseOrderId String
  inventoryItemId String
  quantity        Float
  unitCost        Int // centavos

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([restaurantId])
  @@map("purchase_order_items")
}

// ----------------------------------------------------------------------------
// HRIS module (plan-gated by `hris`)
// ----------------------------------------------------------------------------

enum EmploymentType {
  full_time
  part_time
  contract
}

enum PayType {
  hourly
  daily
  monthly
}

enum EmployeeStatus {
  active
  inactive
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum SwapStatus {
  pending
  approved
  rejected
}

model Employee {
  id             String         @id @default(uuid())
  restaurantId   String
  staffUserId    String?        @unique // optional link to an app login
  fullName       String
  title          String?
  employmentType EmploymentType @default(full_time)
  payRate        Int            @default(0) // centavos (per hour or per month)
  payType        PayType        @default(hourly)
  hiredAt        DateTime?
  contactJson    Json? // phone, address, emergency contact …
  status         EmployeeStatus @default(active)
  clockPin       String? // PIN for login + clock-in at a station
  clockToken     String         @unique @default(uuid()) // for personal-QR clock-in
  createdAt      DateTime       @default(now())

  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  documents     EmployeeDocument[]
  shifts        Shift[]
  availability  Availability[]
  timeEntries   TimeEntry[]
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  swapRequests  ShiftSwapRequest[]
  deductions    PayrollDeduction[]

  @@index([restaurantId])
  @@map("employees")
}

/// A one-off payroll deduction entered by hand (cash advance, loan, uniform,
/// breakage…). Applies to whichever payroll period `appliedOn` falls in, so it
/// shows up once and never repeats.
model PayrollDeduction {
  id           String   @id @default(uuid())
  restaurantId String
  employeeId   String
  label        String
  amount       Int // centavos
  appliedOn    DateTime // date this belongs to (matched against the payroll period)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId, appliedOn])
  @@index([employeeId])
  @@map("payroll_deductions")
}

model EmployeeDocument {
  id           String   @id @default(uuid())
  restaurantId String
  employeeId   String
  name         String
  url          String
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("employee_documents")
}

model Shift {
  id           String   @id @default(uuid())
  restaurantId String
  employeeId   String? // null = open/unassigned shift
  startsAt     DateTime
  endsAt       DateTime
  role         String?
  notes        String?
  createdAt    DateTime @default(now())

  employee     Employee?          @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  swapRequests ShiftSwapRequest[]

  @@index([restaurantId, startsAt])
  @@map("shifts")
}

model Availability {
  id           String @id @default(uuid())
  restaurantId String
  employeeId   String
  dayOfWeek    Int // 0=Sun … 6=Sat
  startMinute  Int // minutes from midnight
  endMinute    Int

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("availabilities")
}

model ShiftSwapRequest {
  id           String     @id @default(uuid())
  restaurantId String
  shiftId      String
  employeeId   String // who requested
  status       SwapStatus @default(pending)
  note         String?
  createdAt    DateTime   @default(now())

  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("shift_swap_requests")
}

model TimeEntry {
  id               String    @id @default(uuid())
  restaurantId     String
  employeeId       String
  clockIn          DateTime
  clockOut         DateTime?
  breakMinutes     Int       @default(0)
  source           String    @default("qr") // qr | pin | selfie
  approved         Boolean   @default(false)
  clockInPhotoUrl  String? // storage path of the clock-in selfie
  clockOutPhotoUrl String? // storage path of the clock-out selfie
  createdAt        DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId, clockIn])
  @@index([employeeId])
  @@map("time_entries")
}

model LeaveType {
  id           String  @id @default(uuid())
  restaurantId String
  name         String
  isPaid       Boolean @default(true)

  requests LeaveRequest[]
  balances LeaveBalance[]

  @@index([restaurantId])
  @@map("leave_types")
}

model LeaveRequest {
  id           String      @id @default(uuid())
  restaurantId String
  employeeId   String
  leaveTypeId  String
  startDate    DateTime
  endDate      DateTime
  status       LeaveStatus @default(pending)
  approverId   String?
  note         String?
  createdAt    DateTime    @default(now())

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("leave_requests")
}

model LeaveBalance {
  id           String @id @default(uuid())
  restaurantId String
  employeeId   String
  leaveTypeId  String
  balance      Float  @default(0) // days

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId])
  @@index([restaurantId])
  @@map("leave_balances")
}

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------

enum OrderType {
  dine_in
  takeout // ordered at the counter, taking it away
  pickup // ordered ahead, collecting it
  delivery
  third_party // Grab / Foodpanda and similar
}

model Order {
  id                  String        @id @default(uuid())
  restaurantId        String
  tableId             String?
  orderType           OrderType     @default(dine_in)
  orderNumber         Int? // daily ticket number for counter/stall orders (resets daily)
  customerName        String? // for pickup / delivery
  customerPhone       String?
  customerAddress     String? // for delivery
  customerLat         Float? // pinned delivery location
  customerLng         Float?
  deliveryStatus      String? // null → out_for_delivery → delivered
  status              OrderStatus   @default(new)
  billRequested       Boolean       @default(false)
  paymentStatus       PaymentStatus @default(unpaid)
  total               Int           @default(0) // centavos (gross subtotal)
  discountAmount      Int           @default(0) // centavos taken off (senior/PWD/custom)
  discountLabel       String? // e.g. "Senior Citizen (20%)"
  creditApplied       Int           @default(0) // centavos paid by a redeemed gift card / store credit
  giftCardId          String? // the gift card credit was redeemed from
  tipAmount           Int           @default(0) // centavos gratuity added at online checkout
  /// Fee added on top for paying by card, in centavos, and what to call it on
  /// the receipt. Written when the card tender is taken, so it reflects the
  /// rate in force at that moment rather than whatever the settings say later.
  ///
  /// Nullable with no default on purpose: a defaulted column is one Prisma
  /// writes into the INSERT of every order, and this ships as a hand-run
  /// migration. Treat null as zero.
  surchargeAmount     Int?
  surchargeLabel      String?
  inventoryDeductedAt DateTime? // set once stock is deducted (idempotency)
  servedAt            DateTime? // set when the cashier confirms the food was served
  /// A second round: the table ate, asked for more, and the cashier punched it
  /// onto the same bill. Stamped every time items are appended to an order that
  /// already existed, so the kitchen card can say "these are extras" instead of
  /// looking like a ticket the cook has somehow already made most of.
  ///
  /// Nullable with no default — it ships as a hand-run migration, and a
  /// defaulted column is one Prisma writes into the INSERT of every order.
  addedItemsAt        DateTime?
  voidedAt            DateTime? // set when a cashier voids the (unpaid) order
  prepMinutes         Int? // prep-time estimate (minutes) a merchant sets on accept
  /// When the order was accepted, which is where prepMinutes counts down FROM.
  ///
  /// A duration on its own is not a deadline. Without this the merchant screen
  /// could only show a static "~20m", and the moment of acceptance cannot be
  /// inferred from createdAt: an advance order booked this morning would read
  /// as hours late the instant somebody accepted it.
  ///
  /// Nullable with no default — it ships as a hand-run migration, and an order
  /// accepted before that ran genuinely has no known acceptance time. Null
  /// means no countdown, rather than a made-up one.
  acceptedAt          DateTime?
  cancelReason        String? // reason a merchant rejected the order
  scheduledFor        DateTime? // advance order: requested pickup/delivery time (null = ASAP)
  approvalStatus      String? // advance order: awaiting | approved | declined (null = not an advance order)
  downpaymentAmount   Int? // centavos owner requires up-front to confirm an advance order
  downpaymentRef      String? // customer's payment reference (e.g. GCash ref) for the downpayment
  downpaymentPaid     Boolean       @default(false) // owner confirmed the downpayment landed
  paymentChoice       String? // website order's chosen method: "cod" | "gcash" (null = not set)
  paymentRef          String? // customer's GCash reference for the full payment
  paymentReceiptUrl   String? // uploaded screenshot of the customer's online payment
  /// What the customer says they'll hand over, on a cash order — so the
  /// cashier can count the change before the rider or the customer arrives
  /// instead of asking at the door. Centavos.
  cashTendered        Int?
  customerNote        String? // customer's note to the rider / kitchen (online orders)
  source              String? // where the order came from: "web" (online site) | null (dine-in/POS)
  /// The cashier who opened this order, shown on the floor so a table can be
  /// traced back to whoever rang it up. Attribution only — every cashier can
  /// still settle every table, or a customer would be stranded the moment the
  /// staff member who served them went on break.
  openedByStaffId     String?
  openedByName        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table?      @relation(fields: [tableId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  feedback   Feedback[]

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt]) // date-range analytics
  @@index([restaurantId, orderNumber]) // daily counter-number lookup
  @@index([tableId])
  @@map("orders")
}

/// Per-restaurant third-party delivery provider config. Standalone (no Prisma
/// relation) so existing restaurant reads stay safe on a lagging DB; the FK is
/// enforced in prisma/manual/add-delivery-bookings.sql.
model DeliverySettings {
  id               String   @id @default(uuid())
  restaurantId     String   @unique
  provider         String   @default("manual") // manual | deeplink | api
  providerKey      String? // informational, e.g. "lalamove"
  deepLinkTemplate String? // URL template with {pickup}/{dropoff}/… tokens
  apiBaseUrl       String?
  credentialsEnc   String? // AES-GCM encryptJson({ apiKey, webhookSecret })
  enabled          Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("delivery_settings")
}

/// A third-party rider booking attached to a delivery order. One per order.
model DeliveryBooking {
  id           String   @id @default(uuid())
  restaurantId String
  orderId      String   @unique
  provider     String // manual | deeplink | api
  providerKey  String?
  bookingRef   String? // the provider's booking id
  status       String   @default("manual") // searching|assigned|picked_up|delivered|cancelled|failed|manual
  fee          Int? // centavos
  etaMinutes   Int?
  riderName    String?
  riderPhone   String?
  riderLat     Float?
  riderLng     Float?
  trackingUrl  String?
  /// Set when the rider says they are at the door. Not a status on the
  /// provider's side either — it happens during "out for delivery" and the
  /// delivery is not over until somebody hands the food across.
  arrivedAt    DateTime?
  /// The last thing the rider said to this diner, kept only so the tracker can
  /// show and announce it. The conversation itself lives on the provider's
  /// tracking page; this is a doorbell, not a second inbox.
  lastMessageAt   DateTime?
  lastMessageBody String?
  raw          Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId])
  @@index([bookingRef])
  @@map("delivery_bookings")
}

/// Shift handover notes — free-text left by one shift for the next.
model ShiftNote {
  id            String   @id @default(uuid())
  restaurantId  String
  authorStaffId String?
  authorName    String?
  body          String
  createdAt     DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("shift_notes")
}

/// Online-ordering cart leads — captured when a diner enters their phone at
/// checkout. If the order isn't placed, a cron sends a recovery message.
model CartLead {
  id            String    @id @default(uuid())
  restaurantId  String
  customerName  String?
  customerPhone String
  itemCount     Int       @default(0)
  total         Int       @default(0) // centavos
  status        String    @default("open") // open | converted | recovered
  recoveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([restaurantId, customerPhone])
  @@map("cart_leads")
}

/// Reservations & waitlist. A booking with a time is a reservation; a `null`
/// reservedAt with status "waitlisted" is a walk-in waiting for a table.
model Reservation {
  id            String    @id @default(uuid())
  restaurantId  String
  customerName  String
  customerPhone String?
  partySize     Int       @default(2)
  reservedAt    DateTime? // the booked slot; null = waitlist (no set time)
  durationMin   Int       @default(90)
  status        String    @default("booked") // booked | seated | cancelled | no_show | waitlisted
  tableId       String? // soft link to a table (no FK — table may be removed)
  note          String?
  source        String? // "online" = self-booked from the website; null = staff-entered
  createdAt     DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, reservedAt])
  @@index([restaurantId, status])
  @@map("reservations")
}

/// Prepaid gift cards / store credit. Balance is server-authoritative — every
/// load/redeem is a GiftCardTxn and the running balance is recomputed from them
/// (the stored `balance` is a cache).
model GiftCard {
  id             String    @id @default(uuid())
  restaurantId   String
  code           String // redemption code (unique per restaurant, case-insensitive)
  initialBalance Int // centavos issued
  balance        Int // centavos remaining
  customerPhone  String? // optional owner
  customerName   String?
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transactions GiftCardTxn[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("gift_cards")
}

/// Ledger of gift-card movements (issue / redeem / restore) for audit + balance.
model GiftCardTxn {
  id           String   @id @default(uuid())
  restaurantId String
  giftCardId   String
  amount       Int // centavos: positive = load/restore, negative = redeem
  kind         String // "issue" | "redeem" | "restore"
  orderId      String?
  createdAt    DateTime @default(now())

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId])
  @@map("gift_card_txns")
}

/// Happy hour / scheduled pricing — time-windowed automatic discounts applied
/// to selected items or categories. Server-authoritative: the discount is
/// recomputed at order time (and shown on the menu), never trusted from the client.
model HappyHour {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  discountType String   @default("percent") // "percent" | "amount"
  value        Int      @default(0) // percent (1-100) or centavos off the item's base price
  scope        String   @default("all") // "all" | "category" | "item"
  targetIds    String[] @default([]) // category ids or item ids when scoped
  days         Int[]    @default([]) // 0=Sun..6=Sat; empty = every day
  startMinute  Int      @default(0) // minutes from midnight (Asia/Manila)
  endMinute    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, active])
  @@map("happy_hours")
}

/// Marketing promotions shown to diners in the app's "Promos" section. Managed
/// by the restaurant from the admin dashboard.
model Promotion {
  id           String    @id @default(uuid())
  restaurantId String
  title        String
  description  String?
  // Coupon redemption: customers enter `code` at checkout to get the offer.
  code         String? // customizable coupon code (unique per restaurant, case-insensitive)
  type         String    @default("info") // info | percent | amount | free_delivery | free_item | bogo
  value        Int       @default(0) // percent (1-100) OR centavos off, depending on type
  freeItemId   String? // menu item for free_item / bogo
  minSpend     Int       @default(0) // centavos: minimum order subtotal to qualify
  expiresAt    DateTime? // optional auto-expiry
  active       Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, active])
  @@index([restaurantId, code])
  @@map("promotions")
}

model OrderItem {
  id             String    @id @default(uuid())
  orderId        String
  menuItemId     String? // nullable: kept as SetNull so deleting a menu item/category
  //          preserves order history (name & price are snapshotted below).
  nameAtTime     String // snapshot of item name
  quantity       Int       @default(1)
  unitPrice      Int // snapshot of base price (centavos)
  note           String?
  /// Ticked off by the kitchen as it goes out — the line is struck through on
  /// every tablet so the pass can see what is still to come. Purely a working
  /// aid: it doesn't move the order's status or touch stock.
  ///
  /// Nullable, no default. Both of these ship as hand-run migrations, and a
  /// defaulted column is one Prisma writes into the INSERT of every order item.
  preparedAt     DateTime?
  /// How many of this line were refunded, and what was handed back (centavos).
  /// Null means none. The money itself is a negative payment row, so the day's
  /// takings need no special-casing anywhere.
  refundedQty    Int?
  refundedAmount Int?

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem  MenuItem?           @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id               String @id @default(uuid())
  orderItemId      String
  modifierId       String
  nameAtTime       String // snapshot of modifier name
  priceDeltaAtTime Int // snapshot of price delta (centavos)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

/// Queue for the "cloud" / server-direct print transport: the printer polls an
/// endpoint and pulls pending jobs (ESC/POS, base64). Also records jobs for the
/// network transport for auditing.
model PrintJob {
  id            String      @id @default(uuid())
  restaurantId  String
  orderId       String?
  method        PrintMethod
  payloadBase64 String // ESC/POS bytes, base64
  status        String      @default("queued") // queued | printed | failed
  // Which printer this is for: "till" (default) or "kitchen", when a restaurant
  // runs a second printer at the pass. Nullable with NO default — a static
  // default would be sent by Prisma on every insert and break printing on a
  // database that lacks the column. Null reads as the till, which is what every
  // job was before a second printer existed.
  station       String?
  createdAt     DateTime    @default(now())
  printedAt     DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@map("print_jobs")
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String
  amount      Int // centavos
  method      PaymentMethod
  gateway     Gateway
  gatewayRef  String? // gateway's checkout/intent id
  status      PaymentStatus @default(pending)
  /// Which cashier took this money, and during which shift. Null for online
  /// payments (no cashier touched them) and for anything recorded before
  /// shift tracking existed — the summary treats both as "not in my drawer".
  staffUserId String?
  shiftId     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([shiftId])
  @@map("payments")
}

// ----------------------------------------------------------------------------
// Feedback & reputation  (NO sentiment gating — see google_invite_shown)
// ----------------------------------------------------------------------------

model Feedback {
  id                String   @id @default(uuid())
  restaurantId      String
  orderId           String?
  rating            Int // 1-5 stars
  comment           String?
  // The Google review invite is shown to EVERYONE regardless of rating.
  googleInviteShown Boolean  @default(false)
  googleClick       Boolean  @default(false)
  createdAt         DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([restaurantId, createdAt]) // rating-trend analytics
  @@map("feedback")
}

// ----------------------------------------------------------------------------
// SMS marketing  (POST-MVP — schema defined now, features built later)
// ----------------------------------------------------------------------------

model CustomerContact {
  id               String           @id @default(uuid())
  restaurantId     String
  phone            String
  name             String?
  marketingConsent MarketingConsent @default(none)
  // Proof of consent — store exactly what was shown and where.
  consentText      String?
  consentSource    String? // "payment_screen" | "feedback_screen"
  optInAt          DateTime?
  confirmedAt      DateTime?
  optOutAt         DateTime?
  createdAt        DateTime         @default(now())

  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  smsMessages SmsMessage[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@map("customer_contacts")
}

model SmsCampaign {
  id             String    @id @default(uuid())
  restaurantId   String
  body           String
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int       @default(0)
  createdAt      DateTime  @default(now())

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  messages   SmsMessage[]

  @@index([restaurantId])
  @@map("sms_campaigns")
}

model SmsMessage {
  id          String   @id @default(uuid())
  campaignId  String
  contactId   String
  status      String // queued | sent | delivered | failed
  providerRef String?
  createdAt   DateTime @default(now())

  campaign SmsCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  CustomerContact @relation(fields: [contactId], references: [id])

  @@index([campaignId])
  @@map("sms_messages")
}

model SmsCreditLedger {
  id           String   @id @default(uuid())
  restaurantId String
  change       Int // +credits purchased, -credits used
  reason       String
  balanceAfter Int
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("sms_credit_ledger")
}

// ----------------------------------------------------------------------------
// Platform announcements
// ----------------------------------------------------------------------------

/// Something the platform owner needs every restaurant to see — a bug being
/// fixed, planned downtime, a new feature.
///
/// Deliberately its own table rather than a column on anything existing: a new
/// table can be missing entirely without breaking a single existing query,
/// which is the safest shape for something added to a live system.
model Announcement {
  id          String    @id @default(uuid())
  title       String
  body        String
  /// info | warning | incident — drives the colour, not the behaviour.
  level       String    @default("info")
  /// Null while a draft. Set when it goes out; only published ones are shown.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reads AnnouncementRead[]

  @@index([publishedAt])
  @@map("announcements")
}

/// One row per person per announcement they've read.
///
/// Per STAFF USER, not per restaurant: the badge is telling one person there's
/// something they haven't seen, and a manager reading it shouldn't clear it for
/// the owner who hasn't.
model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String
  staffUserId    String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, staffUserId])
  @@index([staffUserId])
  @@map("announcement_reads")
}
