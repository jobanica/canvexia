# Resceta — the pharmacy vertical. Deployed at resceta.com (D31).

# --- Domain ------------------------------------------------------------------
# There is nothing to set. Resceta does no host routing — one app, and which
# pharmacy you are looking at comes from the session, never the URL (D30) — and
# it builds no absolute URLs, so it does not read NEXT_PUBLIC_APP_URL at all.
#
# It therefore runs correctly on a vercel.app address, a custom domain, or
# localhost with no change. A variable listed here that nothing reads is worse
# than no variable: it gets set, then trusted.

# --- Database ----------------------------------------------------------------
# The CANVEXIA database. One schema and one database for every product (D25),
# so these are the SAME values Servd uses — same project, same connection.
# Pooled for the app, direct for migrations.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-region.pooler.supabase.com:5432/postgres"

# --- Supabase Auth -----------------------------------------------------------
# Same project as the database. The anon key is public by design: it ships in
# the browser and is subject to RLS.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# SERVER ONLY. Bypasses RLS. Needed for exactly one thing: creating the Supabase
# Auth user behind a staff invite (/staff, and scripts/create-staff.mjs).
# Without it the app runs and signs people in; only ADDING staff fails, with a
# message saying so.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Agent portal (D37): agents.canvexia.com ---------------------------------
# Create the "pharmacy" product in the portal's Products screen; it shows the
# secret once. Set its Callback URL to https://<this app>/api/agent-portal/callbacks.
AGENT_PORTAL_URL="https://agents.canvexia.com"
AGENT_PORTAL_PRODUCT_SLUG="pharmacy"
AGENT_PORTAL_SECRET=""

# Where owners pay (QR / bank transfer), shown on /billing.
PAYMENT_BANK_NAME=""
PAYMENT_ACCOUNT_NAME=""
PAYMENT_ACCOUNT_NUMBER=""
PAYMENT_QR_IMAGE_URL=""

# Self-signup puts new pharmacies under the house partner (CANVEXIA's own
# operator account), found by this email. Same default as
# packages/db/scripts/backfill-house-partner.mjs.
HOUSE_PARTNER_EMAIL="davao@canvexia.ph"

# Protects /api/cron/agent-outbox. openssl rand -hex 32
CRON_SECRET=""

# Used for the email-confirmation link after self-signup.
NEXT_PUBLIC_APP_URL="https://resceta.com"
