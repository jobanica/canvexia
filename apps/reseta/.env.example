# Reseta — the pharmacy vertical. Deployed at risceta.com (D31).

# --- Domain ------------------------------------------------------------------
# Reseta does no host routing: one app, and which pharmacy you are looking at
# comes from the session, never the URL (D30). So this is only the public
# address, used for links and metadata.
NEXT_PUBLIC_APP_URL="https://risceta.com"

# --- Database ----------------------------------------------------------------
# The CANVEXIA database. One schema and one database for every product (D25),
# so these are the SAME values Servd uses — same project, same connection.
# Pooled for the app, direct for migrations.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-region.pooler.supabase.com:5432/postgres"

# --- Supabase Auth -----------------------------------------------------------
# Same project as the database. The anon key is public by design: it ships in
# the browser and is subject to RLS.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# SERVER ONLY. Bypasses RLS. Needed for exactly one thing: creating the Supabase
# Auth user behind a staff invite (/staff, and scripts/create-staff.mjs).
# Without it the app runs and signs people in; only ADDING staff fails, with a
# message saying so.
SUPABASE_SERVICE_ROLE_KEY=""
