# Reseta — pharmacy vertical

# The CANVEXIA database. One schema and one database for every product (D25),
# so these are the same values Servd uses.
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Supabase Auth. The anon key is public by design — it ships in the browser and
# is subject to RLS.
NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."

# SERVER ONLY. Bypasses RLS. Needed for one thing: creating the Supabase Auth
# user behind a staff invite (/staff, and scripts/create-staff.mjs). Without it
# the app runs and signs people in; only adding staff fails, with a message
# saying so.
SUPABASE_SERVICE_ROLE_KEY="..."
