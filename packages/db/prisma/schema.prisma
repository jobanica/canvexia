// ============================================================================
// Servd — data model
//
// MULTI-TENANCY: every tenant-owned table carries `restaurantId`. That column
// is the key that Row-Level Security policies (see packages/db/prisma/rls.sql) filter on,
// so the database itself refuses to return another restaurant's rows.
//
// MONEY SNAPSHOTTING: orders copy the name + price of items/modifiers AT THE
// TIME OF ORDER (`*AtTime` columns). If the menu changes later, old tickets
// and receipts stay historically correct.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum StaffRole {
  kitchen
  cashier
  manager // HR / scheduling
  admin // restaurant owner/admin
  merchant // online "Incoming Orders" screen only (no full cashier UI)
}

enum RestaurantStatus {
  active
  suspended
  pending
  preview // DIY self-serve build — real data, but not a live account yet
  archived // stale preview that never activated; heavy media dropped
}

enum OrderStatus {
  pending // diner placed via QR; awaiting cashier acceptance (not yet in kitchen)
  new
  preparing
  done
  closed // settled by the cashier — leaves the active boards
  cancelled
}

enum PaymentStatus {
  unpaid
  pending
  paid
  failed
  refunded
}

enum PaymentMethod {
  online_gcash
  online_card
  cash
  card_terminal
  gcash // scanned at the counter (in person)
  maya // scanned at the counter (in person)
  bank_transfer // customer transferred to the restaurant's bank account
  /// Grab, Foodpanda and the like. Nothing is tendered at the counter — the
  /// rider collects the food and the platform remits later — so this exists to
  /// close the ticket honestly instead of ringing it up as cash nobody took.
  third_party
}

enum Gateway {
  paymongo
  xendit
  manual // cash / in-person recorded by cashier
}

enum FeedbackMode {
  on_device // prompt on the table device right after payment
  follow_up // send the review invite later via SMS
  both
}

enum PrintMethod {
  network // Wi-Fi / USB ESC/POS at a fixed station (default)
  cloud // printer polls a URL for jobs (CloudPRNT / Server Direct Print)
  bluetooth // Web Bluetooth — Chromium only, BLE ESC/POS only
  os_dialog // OS print dialog / AirPrint to HTML-PDF ticket
}

enum MarketingConsent {
  none // gave number for receipt/order only — NOT marketing permission
  pending // opted in, awaiting double-opt-in confirmation reply
  confirmed // replied YES — fully subscribed
  opted_out // replied STOP — never message again
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

// ----------------------------------------------------------------------------
// Platform-level (no restaurantId — owned by you, the super-admin)
// ----------------------------------------------------------------------------

model PlatformAdmin {
  id          String   @id @default(uuid())
  authUserId  String   @unique // FK to Supabase auth.users
  email       String   @unique
  displayName String?
  /// Back-office scope: "ops" is restricted to the pipeline sections, NULL is
  /// full access. Nullable with NO default on purpose — a default would be
  /// written into the INSERT of every admin row, and NULL already means the
  /// right thing for every admin that existed before roles did.
  role        String?
  /// "active" | "deactivated". A deactivated seat is KEPT — the audit log names
  /// an actor, and deleting the row makes every past HQ action anonymous — but
  /// it does not sign in. Same trade as PartnerUser.status.
  status        String    @default(dbgenerated("'active'"))
  /// platform_admins.id of whoever sent the invite. Null for the bootstrap seat,
  /// which nobody invited.
  invitedBy     String?
  lastSeenAt    DateTime?
  deactivatedAt DateTime?
  createdAt   DateTime @default(now())

  @@map("platform_admins")
}

/// Platform-wide settings owned by the super-admin (single row, id="platform").
/// Holds the subscription billing provider + its encrypted credentials.
model PlatformSetting {
  id                String   @id @default("platform")
  billingProvider   String? // "xendit" | "paymongo" | null
  xenditCredsEnc    String? // encrypted JSON { secretKey, callbackToken }
  crmSequence       Json? // owner-edited CRM follow-up messages (overrides defaults)
  orderCapEnabled   Boolean  @default(false) // master switch for monthly order caps across all restaurants
  tutorials         Json? // course/tutorial hub content (sections + YouTube videos) shown at tutorials.<root>
  featurePrices     Json? // one-time unlock price + sellable flag per gateable feature
  uploadPostKeyEnc  String? // encrypted Upload-Post API key (social scheduling)
  emailCredsEnc     String? // encrypted JSON { apiKey, fromName, fromEmail, replyTo } for marketing email
  emailAutomationOn Boolean  @default(false) // master switch for the acquisition follow-up tracks
  /// YouTube (or Vimeo / MP4) link shown in the /create landing page's
  /// "See how easy it is" section. Empty = the section renders steps only.
  landingVideoUrl   String?
  updatedAt         DateTime @updatedAt

  @@map("platform_settings")
}

/// Feedback / recommendations from restaurant owners ABOUT Servd itself,
/// surfaced to the super-admin. Platform-level (no tenant RLS); written + read
/// through systemDb.
model PlatformFeedback {
  id             String    @id @default(uuid())
  restaurantId   String?
  restaurantName String?
  authorEmail    String?
  rating         Int? // optional 1–5
  message        String
  resolved       Boolean   @default(false)
  /// What the Servd team wrote back, shown to the owner in their own dashboard.
  ///
  /// Kept on the feedback row rather than as a thread: this is a reply to one
  /// message, and a message that has been answered is the whole state anybody
  /// needs. A conversation would need its own table and a place to hold it.
  ///
  /// Nullable with no default, and read best-effort — they ship as a hand-run
  /// migration, and an unanswered message is the normal case.
  reply          String?
  repliedAt      DateTime?
  /// When the owner saw the reply. Drives the unread dot on their sidebar.
  replyReadAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([createdAt])
  @@index([restaurantId])
  @@map("platform_feedback")
}

/// Sales-prospecting leads: restaurants discovered via OpenStreetMap that the
/// platform owner can pursue. Platform-level (super-admin only) — never exposed
/// to tenants. `source`+`sourceId` dedupes the same place across searches.
model ProspectLead {
  id         String    @id @default(uuid())
  source     String    @default("osm") // discovery source
  sourceId   String // e.g. "node/123" — stable per place
  name       String
  address    String?
  latitude   Float?
  longitude  Float?
  phone      String?
  website    String?
  email      String?
  facebook   String?
  status     String    @default("new") // new | contacted | interested | converted | rejected
  notes      String?
  enrichedAt DateTime? // last time we scraped the website for email/FB
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([source, sourceId])
  @@index([status])
  @@index([createdAt])
  @@map("prospect_leads")
}

/// Outreach CRM (platform/super-admin only): clients you message on Facebook,
/// tracked through a follow-up sequence until they reply. Never tenant-visible.
model CrmClient {
  id               String    @id @default(uuid())
  name             String
  facebookUrl      String?
  contactName      String?
  phone            String?
  email            String?
  address          String?
  notes            String?
  stage            String    @default("new") // new | in_sequence | replied | won | lost | revisit
  step             Int       @default(0) // touches sent (0..TOTAL_TOUCHES)
  lastTouchAt      DateTime?
  nextDueAt        DateTime? // when the next follow-up is due
  repliedAt        DateTime?
  revisitAt        DateTime? // when to re-approach a no-reply prospect (revisit bucket)
  demoRestaurantId String? // the demo storefront created for this client, if any
  source           String    @default("manual")

  // --- Business-operations layer (super-admin only) ------------------------
  // Added so ONE pipeline covers both intake tracks. The manual/VA track walks
  // the stages below; a DIY signup is created already paid and skips them.
  // Every column here is nullable with no default and read best-effort: they
  // ship as a hand-run migration, and the outreach board this model already
  // drives must keep working on a database that hasn't run it.
  //
  /// The tenant this lead became, once it exists. Null while still a prospect.
  restaurantId  String?
  /// Fulfillment milestones. Null means "not reached", never "unknown date" —
  /// inventing a timestamp would quietly corrupt every funnel average.
  materialsAt   DateTime?
  productionAt  DateTime?
  previewSentAt DateTime?
  paidAt        DateTime?
  activatedAt   DateTime?
  /// Who is working it, and why it died. Free text: the VA roster is a handful
  /// of people, and a foreign key to auth.users would be a schema change to a
  /// table this layer is forbidden from touching.
  assignedTo    String?
  lostReason    String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  touches        CrmTouch[]
  outreachVideos OutreachVideo[]

  @@index([restaurantId])
  @@index([stage])
  @@index([nextDueAt])
  @@index([revisitAt])
  @@index([createdAt])
  @@map("crm_clients")
}

/// Personalized outreach video (super-admin only): the operator records a short
/// personalized intro on their phone (QR handoff), which is stitched with a
/// pre-baked tail into one vertical MP4 to send manually via Messenger.
model OutreachVideo {
  id                   String    @id @default(uuid())
  crmClientId          String
  status               String    @default("awaiting_recording") // awaiting_recording | uploading | rendering | ready | failed
  recordToken          String?   @unique // short-lived, single-use handoff token for the phone
  recordTokenExpiresAt DateTime?
  introPath            String? // raw phone recording (storage path)
  finalPath            String? // rendered / final MP4 (storage path)
  errorMessage         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  crmClient CrmClient @relation(fields: [crmClientId], references: [id], onDelete: Cascade)

  @@index([crmClientId])
  @@map("outreach_videos")
}

/// One logged outreach touch (initial message / follow-up) for a CRM client.
/// Immutable audit trail for the business-operations layer: every notable
/// moment in a customer's life, newest-first on their profile.
///
/// Write-only from the business's point of view — nothing reads it to decide
/// anything, which is what makes it safe to log from inside live paths. Every
/// call site is fire-and-forget: an analytics row that fails to write must
/// never be the reason an order, a payment or an activation fails.
model CustomerEvent {
  id           String   @id @default(uuid())
  /// Either or both. A DIY signup has a restaurant before it has a CRM row;
  /// an outreach prospect has a CRM row long before it has a restaurant.
  leadId       String?
  restaurantId String?
  /// lead_created | preview_sent | stage_change | payment | activation |
  /// cap_reached | upsell_offered | upsell_sold | note
  eventType    String
  /// Who did it — a super-admin email, or null when the system did.
  actor        String?
  /// Centavos, matching every other money column in the schema. Null when the
  /// event isn't a payment.
  amount       Int?
  meta         Json?
  occurredAt   DateTime @default(now())

  @@index([restaurantId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("customer_events")
}

/// Manual ad-spend entry, so cost per lead and CAC have a real numerator.
///
/// Typed in by hand rather than pulled from Facebook: this layer never holds a
/// third-party credential, and a founder who spends on three platforms would
/// have to reconcile them by hand anyway. Super-admin only.
model AdSpend {
  id        String   @id @default(uuid())
  /// The day the spend belongs to, Manila. Stored as a date-only midnight.
  spendDate DateTime
  platform  String   @default("facebook")
  campaign  String?
  /// Centavos, like every other money column in this schema.
  amount    Int
  createdAt DateTime @default(now())

  @@index([spendDate])
  @@map("ad_spend")
}

model CrmTouch {
  id        String    @id @default(uuid())
  clientId  String
  client    CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  step      Int
  channel   String    @default("facebook")
  label     String?
  createdAt DateTime  @default(now())

  @@index([clientId, createdAt])
  @@map("crm_touches")
}

// ----------------------------------------------------------------------------
// Content Engine (platform/super-admin only): Taglish short-form video scripts
// for Servd's OWN marketing, built on the Jab-Jab-Jab-Right-Hook framework.
// Internal tool — never tenant-visible. All access via systemDb + RLS super_only.
// ----------------------------------------------------------------------------

enum ContentPillarKind {
  JAB
  RIGHT_HOOK
}

enum ContentScriptStatus {
  IDEA
  SCRIPTED
  FILMED
  POSTED
}

/// The brand voice + framework config the generator follows. One row ("Servd").
model ContentBrandProfile {
  id           String   @id @default(cuid())
  name         String   @default("Servd")
  systemPrompt String // editable brand/voice prompt
  jabRatio     Int      @default(3) // jabs per 1 right hook — configurable
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pillars ContentPillar[]
  scripts ContentScript[]

  @@map("content_brand_profiles")
}

/// A content theme. Jabs give value; right hooks make the ask.
model ContentPillar {
  id          String              @id @default(cuid())
  brandId     String
  brand       ContentBrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)
  kind        ContentPillarKind
  name        String
  description String
  active      Boolean             @default(true)
  scripts     ContentScript[]

  @@index([brandId])
  @@map("content_pillars")
}

/// A generated (or hand-edited) short-form video script.
model ContentScript {
  id           String              @id @default(cuid())
  brandId      String
  brand        ContentBrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)
  pillarId     String?
  pillar       ContentPillar?      @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  type         ContentPillarKind
  platform     String // "reels" | "tiktok" | "facebook"
  lengthSec    Int
  title        String
  hook         Json // { visual, audio, textOverlay }
  body         Json // [{ time, action, line }]
  cta          Json? // { verbal, text, action } | null (null for jabs)
  production   Json // { music, bRoll, graphics }
  status       ContentScriptStatus @default(IDEA)
  saves        Int?
  shares       Int?
  dms          Int?
  postedAt     DateTime?
  scheduledFor DateTime?
  createdById  String? // platform admin id/email, if known
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([brandId, createdAt])
  @@index([status])
  @@map("content_scripts")
}

/// Per-call generation log for cost visibility (token spend) + the daily cap.
model ContentGenerationLog {
  id           String   @id @default(cuid())
  brandId      String?
  model        String
  mode         String // "single" | "batch"
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  scriptId     String?
  ok           Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("content_generation_logs")
}

model Plan {
  id            String             @id @default(uuid())
  name          String
  priceMonthly  Int // store money in centavos (integers) to avoid float errors
  /// The least a partner may charge for this plan, in centavos. HQ sets it;
  /// partners price at or above it.
  ///
  /// It exists because partners set their own prices and merchants talk to each
  /// other. Without a floor, one operator undercutting another does not just
  /// start a price war between them — CANVEXIA's 30% is a share of whatever was
  /// actually charged, so the race to the bottom comes out of HQ's revenue too.
  ///
  /// 0 means no floor, which is what every existing plan gets: a floor applied
  /// retroactively to live plans would invalidate prices already being charged.
  priceFloor    Int                @default(dbgenerated("0"))
  /// Partner overrides of this plan's price. See PartnerPlanPrice.
  partnerPrices PartnerPlanPrice[]
  limits        Json // e.g. { maxTables, maxStaff, smsIncluded }
  features      String[]           @default([]) // gateable feature keys this plan grants (super-admin controlled)
  trialDays     Int                @default(30) // free-trial length for new signups
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())

  restaurants   Restaurant[]
  subscriptions Subscription[]
  modules       PlanModule[]

  @@map("plans")
}

enum PlanModuleType {
  hris
  inventory
  custom_domain
}

// Which optional add-on modules a plan unlocks. Read by the entitlements helper
// that F/G/H gate on. Platform-level reference data (no restaurant_id).
model PlanModule {
  planId  String
  module  PlanModuleType
  enabled Boolean        @default(true)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, module])
  @@map("plan_modules")
}

// ----------------------------------------------------------------------------
// Tenant root
// ----------------------------------------------------------------------------

model Restaurant {
  id            String           @id @default(uuid())
  name          String
  slug          String           @unique // used in /order/{slug}/{tableToken}
  /// The address this shop used BEFORE the owner corrected it.
  ///
  /// Changing a slug rewrites the web address printed on every table QR in the
  /// building and shared in every post the shop has ever made. Keeping the old
  /// one here lets those keep working: the public lookup falls back to it, so a
  /// tent card printed last year still opens the right menu.
  ///
  /// Nullable with no default — it ships as a hand-run migration, and it is
  /// genuinely absent for the overwhelming majority of shops.
  previousSlug  String?          @unique
  status        RestaurantStatus @default(pending)
  planId        String?
  // Set when a partner creates this as a DEMO storefront (no login) to pitch a
  // prospect. Null for real tenants + super-admin demos.
  demoPartnerId String?
  /// The CANVEXIA partner (city operator) this merchant belongs to.
  ///
  /// Distinct from demoPartnerId, which only ever meant "a partner built this
  /// preview". This is ownership: it decides whose brand the merchant renders
  /// under, whose statement its subscription lands on, and — once the partner
  /// policies below are live — who the database will let read its rows at all.
  ///
  /// Nullable because it is backfilled, not created: every restaurant that
  /// existed before CANVEXIA is moved under the house partner by
  /// scripts/backfill-house-partner.mjs. A null here after that point is a bug,
  /// not a state to design around.
  partnerId     String?
  /// The partner SEAT that signed this merchant, and the one that supports it.
  /// Distinct from partnerId, which names the operator company. A7 uses these
  /// for "merchants assigned to me"; both are null for everything that existed
  /// before, which reads as unassigned and is correct.
  assignedSalesUserId   String?
  assignedSupportUserId String?
  // When a partner ran the AI menu scan on this storefront. One scan per demo:
  // it's an AI vision call billed to us, and a partner opens unlimited demos.
  // Nullable with NO default — a static default would be sent by Prisma on
  // every insert and break creates on a database that lacks the column.
  // Deliberately a timestamp rather than a boolean: "when" answers questions a
  // flag can't, and reads as false when null either way.
  menuScannedAt DateTime?

  // --- White-label branding (defaults give a clean "Servd look") ---
  displayName       String?
  logoUrl           String?
  brandPrimaryColor String? // null => inherit Servd default
  brandAccentColor  String?
  coverImageUrl     String?
  tagline           String?
  // Plan-banner override (super-admin): "legacy" hides the banner entirely,
  // "lite" marks the hidden 300-order save offer. null → derive from the plan.
  bannerPlan        String?

  // --- Business location (set by super-admin at creation; shown on the
  // super-admin map so they can visit the business) ---
  businessAddress String?
  latitude        Float?
  longitude       Float?

  // --- Claim flow: created by super-admin with no login; the owner opens the
  // claim link to set their email + password. Token cleared once claimed. ---
  claimToken String?   @unique
  claimedAt  DateTime?

  // --- Reputation ---
  googleReviewUrl String?
  feedbackMode    FeedbackMode @default(follow_up)

  // --- Printing ---
  printMethod      PrintMethod @default(network)
  printerConfig    Json? // transport-specific details (ip, port, cloudprnt url…)
  autoPrint        Boolean     @default(false)
  // Print a receipt automatically when a payment settles. Default on, because
  // that was the only behaviour before this was a choice — but a till whose
  // customers don't want paper was burning a roll a day with no way to stop it.
  //
  // The default is dbgenerated rather than a plain `@default(true)`, and that
  // is load-bearing for every column added after this line too. A plain default
  // is applied by PRISMA: it puts the column into the INSERT of every
  // restaurant.create() in the codebase, whether or not the caller mentioned
  // it. On a live database that hasn't run the matching file in packages/db/prisma/manual
  // yet, that turns a brand-new column into "cannot create a restaurant at
  // all" — creating a storefront died on `qrGrandfathered` exactly this way.
  // Handing the default to the database instead means Prisma never names the
  // column, so a create keeps working right through the migration lag and the
  // column starts carrying its default the moment the SQL is run.
  autoPrintReceipt Boolean     @default(dbgenerated("true"))
  // When to pop the cash drawer: never | cash (cash payments only) | any.
  // A card or GCash sale puts nothing in the drawer, so "cash" is the default —
  // but a till that gives change for e-wallets can choose "any".
  openDrawerOn     String      @default(dbgenerated("'cash'"))
  cashierVoidPin   String? // PIN a cashier must enter to void an unpaid order
  // Kitchen routing: true => on-screen kitchen display; false => print a kitchen
  // ticket for the kitchen when an order is accepted/created (no screen).
  kitchenDisplay   Boolean     @default(true)

  // --- Payments (connected-accounts model) ---
  // Each restaurant stores its OWN PayMongo credentials, encrypted at rest.
  paymentGateway        Gateway? // null until they connect a gateway
  paymentCredentialsEnc String? // encrypted blob — never stored in plaintext
  paymentOnlineEnabled  Boolean  @default(false)

  // --- SMS (post-MVP) ---
  smsSenderName    String?
  smsCreditBalance Int     @default(0)
  // Default to double opt-in (confirmation reply required); single is a fallback.
  smsDoubleOptIn   Boolean @default(true)

  // Premium custom-domain tier (gated by the custom_domain plan module).
  uploadPostUser         String?   @unique // Upload-Post profile username for social scheduling
  subdomain              String?   @unique
  customDomain           String?   @unique
  customDomainVerifiedAt DateTime?

  // Self-serve onboarding: null until the owner finishes/dismisses the wizard.
  onboardingCompletedAt DateTime?

  // --- DIY self-serve builder (public, no-login funnel at /build) ---
  // A DIY build starts as status=preview and only becomes a real account once
  // the ₱499 activation invoice is paid (verified by the Xendit webhook).
  buildToken            String?   @unique // capability token: lets an anon builder return to edit
  builtVia              String    @default("manual") // "diy" | "manual"
  contactEmail          String? // lead capture — required on a DIY build (email marketing)
  contactPhone          String?
  contactFb             String?
  /// The Facebook post showing this prospect their preview storefront. Kept
  /// apart from contactFb, which is how to REACH them and feeds the follow-up
  /// list — a post link there would break chasing them.
  previewPostUrl        String?
  emailOptOut           Boolean   @default(false) // unsubscribed from platform marketing email
  unsubToken            String?   @unique // one-click unsubscribe link, no login needed
  previewCreatedAt      DateTime? // build started
  previewReachedAt      DateTime? // first time they saw their own storefront
  activationRequestedAt DateTime? // tapped "Activate" (invoice created)

  // Which ad brought them, captured at /create and stamped on at first save.
  // Kept on the lead itself so an activation can be traced back to a creative —
  // the only number that decides where the ad budget goes.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?

  // Language the base menu text was written in (the i18n fallback).
  defaultLocale String @default("en")

  // Inventory: auto-flip a menu item to out-of-stock when an ingredient hits 0.
  autoOutOfStock     Boolean @default(false)
  /// Kept unlimited tables/QRs from before that became a paid unlock. Set once,
  /// by the migration, for every account that already existed — never for a new
  /// one. Changing the rules on people who already built their floor plan
  /// around them is not a thing we do.
  ///
  /// dbgenerated, not `@default(false)` — see the note above `autoPrintReceipt`.
  qrGrandfathered    Boolean @default(dbgenerated("false"))
  lowStockAlertPhone String? // phone to SMS when an ingredient drops to its reorder level

  // --- Loyalty & rewards (points per peso) ---
  loyaltyEnabled       Boolean @default(false)
  loyaltyPesosPerPoint Int     @default(20) // ₱ spent to earn 1 point
  loyaltyPointValue    Int     @default(100) // centavos a point is worth on redeem

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan               Plan?                 @relation(fields: [planId], references: [id])
  staff              StaffUser[]
  subscriptions      Subscription[]
  tables             Table[]
  categories         Category[]
  menuItems          MenuItem[]
  modifierGroups     ModifierGroup[]
  orders             Order[]
  printJobs          PrintJob[]
  cashierShifts      CashierShift[]
  feedback           Feedback[]
  promotions         Promotion[]
  customers          CustomerContact[]
  smsCampaigns       SmsCampaign[]
  auditLogs          AuditLog[]
  happyHours         HappyHour[]
  giftCards          GiftCard[]
  reservations       Reservation[]
  cartLeads          CartLead[]
  shiftNotes         ShiftNote[]
  smsCreditLedger    SmsCreditLedger[]
  invoices           RestaurantInvoice[]
  addonPurchases     AddonPurchase[]
  activationRequests ActivationRequest[]
  emailSends         EmailSend[]
  payrollDeductions  PayrollDeduction[]
  socialPosts        SocialPost[]
  featureSubs        FeatureSubscription[]
  suppliers          Supplier[]
  inventoryItems     InventoryItem[]
  purchaseOrders     PurchaseOrder[]
  employees          Employee[]
  loyaltyAccounts    LoyaltyAccount[]
  loyaltyTxns        LoyaltyTransaction[]
  expenses           Expense[]
  payrollSetting     PayrollSetting?
  menuItemCosts      MenuItemCost[]
  storefront         StorefrontSetting?
  pushSubscriptions  PushSubscription[]

  assignedSales   PartnerUser? @relation("RestaurantSalesAssignee", fields: [assignedSalesUserId], references: [id], onDelete: SetNull)
  assignedSupport PartnerUser? @relation("RestaurantSupportAssignee", fields: [assignedSupportUserId], references: [id], onDelete: SetNull)

  @@index([demoPartnerId])
  @@index([assignedSalesUserId])
  @@map("restaurants")
}

/// Web Push subscriptions for merchant devices — lets a new online order alert
/// the phone even when the Incoming Orders app is minimized or closed.
model PushSubscription {
  id           String   @id @default(uuid())
  restaurantId String
  /// Set when a diner subscribed from their own order tracker rather than a
  /// merchant subscribing their till. Merchant sends match on restaurantId and
  /// ignore this; a diner send matches on it alone, so the two never cross.
  orderId      String?
  endpoint     String   @unique
  p256dh       String // subscription public key
  auth         String // subscription auth secret
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([orderId])
  @@map("push_subscriptions")
}

/// Public website settings: store hours + delivery zones/fees.
model StorefrontSetting {
  id                String   @id @default(uuid())
  restaurantId      String   @unique
  hours             Json? // [{open,close,closed}] index 0=Sun … 6=Sat
  deliveryZones     Json? // [{name, fee}] fee in centavos
  pauseWhenClosed   Boolean  @default(false) // block online orders outside hours
  /// Manual "stop taking online orders" switch, for when the kitchen is buried.
  ///
  /// Separate from pauseWhenClosed, which is automatic and tied to opening
  /// hours. This one is the owner deciding, right now, regardless of the clock
  /// — and it has to be flipped back by hand, which is the point: it should
  /// never quietly turn itself on again mid-service.
  ///
  /// Nullable with NO default: a static default would be sent by Prisma on
  /// every insert and break saving storefront settings on a database that
  /// lacks the column. Null means not paused.
  ordersPaused      Boolean?
  /// Accept an online order by itself if nobody has answered it within this
  /// many seconds. Null or 0 means off, which is how every shop behaves until
  /// somebody turns it on.
  ///
  /// Seconds rather than a boolean so the wait is the shop's decision: a busy
  /// counter wants ten, a kitchen that genuinely vets every order wants a
  /// minute or nothing at all.
  ///
  /// Nullable with NO default, like ordersPaused above and for the same
  /// reason: a static default is a value Prisma writes into the INSERT of every
  /// storefront_settings row, which breaks saving settings on a database that
  /// has not run the migration.
  autoAcceptSeconds Int?
  acceptsBookings   Boolean  @default(false) // show the "Book a table" flow on the website
  bookingConfig     Json? // { requireDownpayment, downpaymentType, downpaymentValue, downpaymentInstructions }
  paymentConfig     Json? // { codEnabled, gcashEnabled, gcashName, gcashNumber, gcashQrUrl }
  deliveryConfig    Json? // { mode, baseFee, perKm, freeKm, minFee, maxKm, roadFactor, originLat, originLng }

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("storefront_settings")
}

/// Customizable statutory payroll deductions per restaurant (PH).
model PayrollSetting {
  id               String  @id @default(uuid())
  restaurantId     String  @unique
  sssAmount        Int     @default(0) // fixed centavos per pay period (employee share)
  philhealthAmount Int     @default(0)
  pagibigAmount    Int     @default(0)
  birAmount        Int     @default(0)
  thirteenthMonth  Boolean @default(false) // accrue 1/12 of base

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("payroll_settings")
}

/// Food cost per menu item (for accounting COGS). Stored separately so adding it
/// never affects the hot menu read paths.
model MenuItemCost {
  id           String @id @default(uuid())
  restaurantId String
  menuItemId   String @unique
  cost         Int    @default(0) // centavos per item

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("menu_item_costs")
}

/// A business expense for the accounting section (rent, supplies, payroll, …).
model Expense {
  id           String   @id @default(uuid())
  restaurantId String
  date         DateTime
  category     String
  amount       Int // centavos
  note         String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, date])
  @@map("expenses")
}

/// A cash drawer movement — currently used for cash-outs (money removed from
/// the drawer, e.g. the owner taking cash). Kept separate from expenses so it
/// doesn't distort the P&L; it only affects expected cash in the drawer.
model CashMovement {
  id           String   @id @default(uuid())
  restaurantId String
  type         String   @default("cash_out") // cash_out (future: cash_in / float)
  amount       Int // centavos
  note         String?
  staffEmail   String? // who recorded it
  shiftId      String? // the cashier shift it came out of
  createdAt    DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([shiftId])
  @@map("cash_movements")
}

/// One cashier's turn at the till.
///
/// Opened the first time they act on the cashier screen, closed by "End shift"
/// (which prints the Z-report and signs them out). Every payment and cash-out
/// they take is stamped with it, so the summary counts THEIR drawer rather than
/// the whole restaurant's day — the previous behaviour, where a cashier saw the
/// takings of everyone before them, is what made separate logins pointless.
///
/// A stale shift (browser closed, session expired) is auto-closed at the start
/// of the next business day rather than carrying over.
model CashierShift {
  id           String    @id @default(uuid())
  restaurantId String
  staffUserId  String
  /// Snapshot of the name, so a renamed or deleted login keeps its Z-report.
  staffName    String
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  status       String    @default("open") // open | closed
  closedReason String? // ended | auto_end_of_day

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([restaurantId, staffUserId, openedAt])
  @@map("cashier_shifts")
}

/// A customer's loyalty balance at a restaurant, keyed by phone number.
model LoyaltyAccount {
  id           String   @id @default(uuid())
  restaurantId String
  phone        String
  name         String?
  points       Int      @default(0)
  totalEarned  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, phone])
  @@map("loyalty_accounts")
}

/// An audit trail of points earned / redeemed / adjusted.
model LoyaltyTransaction {
  id           String   @id @default(uuid())
  restaurantId String
  phone        String
  orderId      String?
  points       Int // signed: + earned, - redeemed
  kind         String // earn | redeem | adjust
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, phone])
  @@map("loyalty_transactions")
}

model StaffUser {
  id               String    @id @default(uuid())
  restaurantId     String
  // Authentication is handled by Supabase Auth (passwords live in auth.users,
  // hashed + salted by Supabase). We DON'T roll our own password storage.
  // NOT globally unique: one login can be staff at several restaurants, which
  // is how an owner runs multiple branches from a single account. Unique per
  // restaurant instead, so they still can't hold two roles in the same shop.
  authUserId       String
  role             StaffRole
  email            String
  username         String?   @unique // optional login handle (super-admin can create by username)
  displayName      String?
  /// Set only on a throwaway login made to demo a storefront to a prospect.
  /// Carrying an expiry IS what makes it temporary — there is no second boolean
  /// to fall out of step with it. NULL on every real staff account, which is
  /// what the conversion check and the staff list both rely on.
  previewExpiresAt DateTime?
  createdAt        DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, email])
  @@unique([restaurantId, authUserId])
  @@index([restaurantId])
  // Every request resolves the session by authUserId, so this one is hot.
  @@index([authUserId])
  @@map("staff_users")
}

model Subscription {
  id                      String             @id @default(uuid())
  restaurantId            String // current subscription is the latest row; app keeps one active
  planId                  String
  status                  SubscriptionStatus @default(trialing)
  trialEndsAt             DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean            @default(false)
  // Dunning: how many consecutive charge attempts have failed.
  failedCharges           Int                @default(0)
  // Gateway refs for off-session recurring charges (platform's PayMongo account).
  providerCustomerId      String?
  providerPaymentMethodId String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       Plan       @relation(fields: [planId], references: [id])

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model RestaurantInvoice {
  id           String    @id @default(uuid())
  restaurantId String
  amount       Int // centavos
  status       String    @default("open") // open | paid | failed | void
  periodStart  DateTime
  periodEnd    DateTime
  providerRef  String? // gateway payment-intent id
  paidAt       DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("restaurant_invoices")
}

/// A per-feature MONTHLY subscription (e.g. the content scheduler at ₱499/mo).
/// Separate from the plan and from one-time AddonPurchases: access is granted
/// only while `status` is active and `currentPeriodEnd` is still in the future,
/// so a trial never unlocks it and the first month must be paid up front.
model FeatureSubscription {
  id               String    @id @default(uuid())
  restaurantId     String
  feature          String // gateable feature key, e.g. "contentScheduler"
  status           String    @default("pending") // pending | active | past_due | cancelled
  priceMonthly     Int // centavos, snapshotted at purchase
  currentPeriodEnd DateTime?
  providerRef      String?   @unique // latest gateway checkout/invoice id
  renewUrl         String? // hosted checkout for the pending renewal, if any
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, feature])
  @@index([status, currentPeriodEnd])
  @@map("feature_subscriptions")
}

/// A social post composed in the app and published/scheduled through
/// Upload-Post. `providerRef` is the request id it returns, so a post can be
/// traced back to the provider.
model SocialPost {
  id           String    @id @default(uuid())
  restaurantId String
  caption      String
  mediaUrl     String? // uploaded image; null = text-only post
  platforms    String // comma-separated: "facebook,instagram"
  scheduledFor DateTime? // null = published immediately
  status       String    @default("scheduled") // scheduled | posted | failed
  providerRef  String? // Upload-Post request_id
  error        String?
  postedAt     DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, scheduledFor])
  @@map("social_posts")
}

/// A ONE-TIME add-on a restaurant buys from Servd (currently the custom-domain
/// unlock for Free/trial accounts). Deliberately separate from
/// RestaurantInvoice: paying one of these must never activate or extend a
/// subscription, only grant the add-on.
model AddonPurchase {
  id           String    @id @default(uuid())
  restaurantId String
  addon        String // "custom_domain"
  amount       Int // centavos
  status       String    @default("pending") // pending | paid | failed
  providerRef  String?   @unique // gateway invoice/checkout id
  paidAt       DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, addon])
  @@map("addon_purchases")
}

/// One "activate my DIY preview for ₱499" attempt. The Xendit invoice's
/// external_id is this row's id, so the verified webhook knows exactly which
/// preview to turn into a real account. Rows are never deleted — an abandoned
/// one is the founder's warm-lead follow-up list.
model ActivationRequest {
  id            String    @id @default(uuid())
  restaurantId  String
  status        String    @default("pending") // pending | paid | activated | abandoned
  amount        Int       @default(49900) // centavos
  contactPhone  String?
  contactFb     String?
  note          String?
  providerRef   String?   @unique // Xendit invoice id — the idempotency key
  checkoutUrl   String? // hosted Xendit invoice URL (so we can re-offer it)
  /// Username of the login created on activation. The PASSWORD is never stored:
  /// the owner sets their own through the one-time claim link.
  loginUsername String?
  paidAt        DateTime?
  activatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([restaurantId])
  @@map("activation_requests")
}

/// One marketing email blast to a segment of leads. Platform-level: the
/// audience is restaurants (owners who built a preview), not their diners —
/// per-restaurant customer messaging is the SMS campaign system.
model EmailCampaign {
  id         String    @id @default(uuid())
  subject    String
  body       String // plain text with {{name}} merge tags
  segment    String // audience key — see server/email/audience.ts
  status     String    @default("draft") // draft | sending | sent | failed
  recipients Int       @default(0)
  sent       Int       @default(0)
  failed     Int       @default(0)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  messages EmailMessage[]

  @@index([status, createdAt])
  @@map("email_campaigns")
}

/// One recipient of one campaign. Kept after sending so a re-send can skip
/// anyone who already got it, and so failures are visible rather than silent.
model EmailMessage {
  id           String    @id @default(uuid())
  campaignId   String
  restaurantId String?
  email        String
  status       String    @default("queued") // queued | sent | failed
  error        String?
  providerRef  String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@map("email_messages")
}

/// Editable copy for one step of an acquisition track. The SEQUENCE (which
/// steps exist and when they land) is fixed in lib/email/tracks.ts; only the
/// words and the on/off switch live here, so a founder can rewrite a subject
/// line without being able to accidentally reshape the funnel.
model EmailTemplate {
  id        String   @id @default(uuid())
  stepKey   String   @unique // "A_immediate", "B_day3", …
  subject   String
  body      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

/// One scheduled email to one lead. Rows are written the moment someone enters
/// a track, so the whole sequence is visible before any of it goes out — and
/// the unique pair means a step can never be scheduled, or sent, twice.
model EmailSend {
  id           String    @id @default(uuid())
  restaurantId String
  track        String // "A" | "B"
  stepKey      String
  sendAt       DateTime
  /// Stamped when a run CLAIMS the row, then again on success — so while the
  /// status is `sending` this doubles as "when did a pass take this", which is
  /// how a crashed run's rows get recovered.
  sentAt       DateTime?
  /// scheduled → sending → sent, or back to scheduled on a retryable failure.
  status       String    @default("scheduled") // scheduled | sending | sent | skipped | failed
  skipReason   String? // activated | unsubscribed | moved_to_B | disabled | …
  attempts     Int       @default(0)
  error        String?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, stepKey])
  @@index([status, sendAt])
  @@index([restaurantId])
  @@map("email_sends")
}

/// Fixed-window counter for unauthenticated endpoints (the public builder).
/// Platform-level: no tenant owns it, and it's only ever touched by systemDb.
model RateLimit {
  id       String   @id @default(uuid())
  bucket   String // "build:create", "build:upload", …
  key      String // hashed client IP — never the raw address
  windowAt DateTime // start of the fixed window
  count    Int      @default(0)

  @@unique([bucket, key, windowAt])
  @@index([windowAt])
  @@map("rate_limits")
}

/// Landing-page counters for the ad funnel: views and CTA clicks on /create,
/// per Manila day and per UTM combination.
///
/// Aggregated rather than one row per hit — an ad campaign generates a lot of
/// views, and none of them are individually interesting. The empty string, not
/// NULL, marks a missing tag: Postgres treats NULLs as distinct in a unique
/// index, which would silently split one campaign's counter into many rows.
model LandingStat {
  id       String @id @default(uuid())
  day      String // "YYYY-MM-DD" in Manila
  event    String // "view" | "cta"
  source   String @default("")
  medium   String @default("")
  campaign String @default("")
  content  String @default("")
  count    Int    @default(0)

  @@unique([day, event, source, medium, campaign, content])
  @@index([day])
  @@map("landing_stats")
}

// ----------------------------------------------------------------------------
// Partner program
// ----------------------------------------------------------------------------
//
// This used to be an affiliate scheme in two tracks: a restaurant that referred
// another restaurant earned account credit (Track 1), and a platform partner
// earned a recurring percentage of the subscriptions they brought in (Track 2),
// with milestone bonuses, payout batches, clawbacks and withholding on top.
//
// None of that exists any more. A partner sets restaurants up themselves, as
// many as they like, and bills those restaurants directly at whatever price
// they agree; Servd never sees that price and never takes or pays a share. So
// there is nothing to attribute, accrue, claw back or pay out, and the tables
// that existed only to track money moving between us and a partner are gone:
// referral_codes, referrals, referral_events, commissions, payouts,
// partner_bonuses and account_credits.
//
// Dropping the tables themselves is optional and destructive — see
// packages/db/prisma/manual/drop-referral-program.sql. Nothing reads them, so leaving them
// in place is harmless.

/// A platform partner. Has its own login (Supabase auth) and can set up an
/// unlimited number of restaurants, which they bill directly.
model Partner {
  id         String  @id @default(uuid())
  authUserId String? @unique // Supabase auth user for the partner portal
  name       String
  email      String  @unique
  status     String  @default("pending") // pending | approved | suspended | rejected
  /// "reseller" = the legacy zero-cut program. "operator" = a CANVEXIA city
  /// operator on a revenue share. "affiliate" survives only on old rows.
  ///
  /// This column is the grandfather line. The old program took no cut and said
  /// so in writing; those partners keep those terms, so their tier stays
  /// "reseller" and their revenueSharePct stays 0. Only "operator" carries a
  /// share, and an operator with a 0% share is rejected — see
  /// src/lib/partners/revenue-share.ts, because a silent 0 there is CANVEXIA
  /// earning nothing on a partner forever and nothing surfacing to say so.
  tier       String  @default("reseller")

  // --- CANVEXIA operator fields ---------------------------------------------
  // All nullable or database-defaulted, because every one of them is being
  // added to a table that already has rows in production. A plain Prisma
  // default would be written into the INSERT of every partner.create() in the
  // codebase and break creates on a database that has not yet run
  // packages/db/prisma/manual/add-partner-tenancy.sql — the failure mode described at
  // length on Restaurant.autoPrintReceipt.
  //
  /// URL label for the {slug}.canvexia.app fallback domain.
  slug                String? @unique
  /// Display name, logo, colors, support contacts, legal footer. Shape lives in
  /// packages/core/src/branding. Null = inherit the platform's own brand.
  brandConfig         Json?
  /// City or province this operator is licensed for. Free text until HQ
  /// territory management lands in Phase 2.
  territory           String?
  /// The operator's cut of merchant subscription revenue, as a percentage.
  /// 0 for every legacy partner; 70 for a CANVEXIA operator.
  revenueSharePct     Int     @default(dbgenerated("0"))
  /// Who takes the merchant's money: "partner_collects" (the operator's own
  /// gateway account, the CANVEXIA default) or "hq_collects".
  collectionMode      String  @default(dbgenerated("'partner_collects'"))
  /// "powered_by" keeps a CANVEXIA/Servd credit on customer-facing surfaces;
  /// "full_whitelabel" removes it. Reconciled with the per-merchant white-label
  /// unlock in Phase 5 — today they are two systems answering one question.
  brandMode           String  @default(dbgenerated("'powered_by'"))
  /// This operator's sub-account under CANVEXIA's own gateway platform.
  ///
  /// An IDENTIFIER, not a secret — which is the whole point of D5 Option B. The
  /// only gateway credential on the platform stays the one in
  /// PlatformSetting.xenditCredsEnc; a call on a partner's behalf is made with
  /// that key and names this sub-account. So a partner never hands over an API
  /// key, CANVEXIA never stores N of them, and a leak here exposes an account
  /// number rather than the ability to move money.
  ///
  /// Null until the partner is onboarded with the gateway. A partner without one
  /// cannot take merchant payments yet, which is a state the portal has to show
  /// rather than a state to crash on.
  gatewaySubAccountId String?
  // Payout/tax columns from the commission era. Servd pays partners nothing, so
  // new applications never fill these in; they stay only to preserve what was
  // already collected. Nothing reads them.
  payoutMethod        String?
  payoutDetailsEnc    String?
  taxInfoEnc          String?

  // --- Licence term and milestones (partner portal, Phase A) ----------------
  /// When this operator's licence started. Null for a partner who predates the
  /// licence model; the portal shows "not set" rather than computing a pace
  /// from an invented date.
  licenseStartedAt     DateTime?
  /// When exclusivity lapses if milestones are missed. HQ sets it.
  exclusivityExpiresAt DateTime?
  /// The milestone ladder, as `[{ "month": 1, "target": 10 }, …]`.
  ///
  /// A LADDER, not two columns. The brief asked for a 6-month and a 12-month
  /// target; the operating answer was three checkpoints (10 by month 1, 25 by
  /// month 3, 50 by month 6). Those are different models, and HQ wanting a
  /// fourth checkpoint for one city should not be a migration. Shape and
  /// defaults live in packages/core/src/partners/milestones.ts, which is where
  /// the pace maths is tested.
  ///
  /// Null means "use the platform default", NOT "no milestones" — a partner
  /// with no ladder at all would silently always read as on track.
  milestones           Json?
  /// Which onboarding steps are done, as `{ "brand": true, … }`, plus
  /// `dismissedAt`. Per-partner rather than per-user: the checklist is about
  /// the territory, and two admins should not each be asked to add payout
  /// details.
  onboardingSteps      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- HQ console (Phase H1) -----------------------------------------------
  /// CANVEXIA's own account. Exactly one row may hold it — a partial unique
  /// index enforces that — and it is the target "reassign to the house partner"
  /// and "flag as a national account" resolve to. Without it nothing in this
  /// schema distinguishes CANVEXIA Davao from any other operator.
  isHouse           Boolean @default(dbgenerated("false"))
  /// On a national account, the partner who introduced the merchant and is owed
  /// a referral line on their statement. The merchant itself belongs to the
  /// house account.
  referralPartnerId String?
  legalName         String?
  businessName      String?
  /// Business registration number. Deliberately NOT encrypted and not masked: a
  /// TIN appears on every invoice this partner issues. The secrets here are
  /// payoutDetailsEnc and taxInfoEnc.
  tin               String?
  address           String?
  contactMobile     String?
  /// Supabase Storage PATH in the private `partner-agreements` bucket, never a
  /// URL. Served through a signed URL, same as employee-documents.
  agreementPath       String?
  agreementUploadedAt DateTime?
  /// Centavos — unlike Territory.licenseFee, which is whole pesos. They are
  /// different quantities: that is a quoted price, this is money that arrived.
  licenseFeePaidCentavos Int?
  licenseFeePaidAt       DateTime?
  licenseFeeRef          String?
  /// The licensed territory, once HQ has mapped it. `territory` above stays as
  /// the free text it has always been — same trade as authUserId.
  territoryId     String?
  /// Which products this partner may provision into, as `["servd", …]`. NULL
  /// means every live product, which is what every existing partner has; an
  /// empty array would silently switch them all off.
  enabledProducts Json?

  users      PartnerUser[]
  invites    PartnerInvite[]
  prospects  Prospect[]
  statements PartnerStatement[]
  planPrices PartnerPlanPrice[]

  territoryRow        Territory?            @relation("PartnerTerritory", fields: [territoryId], references: [id], onDelete: SetNull)
  territories         Territory[]           @relation("TerritoryHolder")
  territoryAssignments TerritoryAssignment[]
  featureFlags        FeatureFlag[]
  announcementReads   HqAnnouncementRead[]
  impersonationGrants ImpersonationGrant[]
  outboundEmails      OutboundEmail[]
  passthroughUsage    PassthroughUsage[]

  // --- A7: staff, field work, commissions ------------------------------------
  /// Where a public lead goes when no active sales seat can take it by
  /// round-robin. Null means "leave it unassigned", which is honest: inventing
  /// an owner for a lead nobody is responsible for is how leads go cold
  /// silently rather than visibly.
  defaultLeadUserId    String?
  rolePermissions      PartnerRolePermission[]
  staffEvents          StaffEvent[]
  staffTargets         StaffTarget[]
  attendanceSessions   AttendanceSession[]
  staffVisits          StaffVisit[]
  commissionRules      CommissionRule[]
  commissionStatements CommissionStatement[]

  referralPartner Partner?  @relation("PartnerReferral", fields: [referralPartnerId], references: [id], onDelete: SetNull)
  referredBy      Partner[] @relation("PartnerReferral")

  @@index([territoryId])
  @@map("partners")
}

// ----------------------------------------------------------------------------
// Partner portal identity (Phase A1)
//
// Until now a partner WAS one Supabase user: partners.authUserId, one row, one
// login. The portal needs three roles and more than one person per city, so the
// identity moves here — and `Partner.authUserId` stays, carrying the original
// login, because breaking every live session to normalise a column is not a
// trade worth making. `getCurrentPartner()` reads this table first and that
// column second; the migration backfills an admin row for every partner that
// has one, so nobody is logged out.
// ----------------------------------------------------------------------------

/// One person who can sign into one partner's portal.
model PartnerUser {
  id         String  @id @default(uuid())
  partnerId  String
  /// Supabase auth user. NULL while an invite is outstanding — the row exists
  /// so the seat is visible and revocable before it is ever used.
  authUserId String? @unique
  email      String
  name       String?
  /// "admin" | "sales" | "support". A CHECK constraint enforces the set in the
  /// database; `packages/core/src/identity/roles.ts` owns the vocabulary.
  ///
  /// Not a Postgres enum on purpose: the role list belongs to core, and an
  /// enum would make adding one a schema migration coupled to a code release.
  /// A CHECK is altered in one statement and still refuses a typo.
  role       String
  /// "invited" | "active" | "deactivated". Deactivated rows are KEPT: the audit
  /// log names an actor, and deleting the seat makes past actions anonymous.
  status     String  @default("invited")

  invitedAt     DateTime  @default(now())
  acceptedAt    DateTime?
  deactivatedAt DateTime?
  lastSeenAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Staff record (A7) ----------------------------------------------------
  // On this table rather than a parallel staff_profiles: a seat and a staff
  // member are the same person here, and a 1:1 table would add a join and a way
  // for the two to disagree.
  mobile    String?
  zone      String?
  startDate DateTime?
  /// Storage PATH in the private partner-attendance bucket, never a URL.
  photoPath String?
  /// Read ONLY by a seat holding hr.view_all. Never selected otherwise — a
  /// value that reaches the client hidden is a value in the payload.
  emergencyName   String?
  emergencyMobile String?

  partner           Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  notificationPrefs NotificationPref[]
  assignedProspects Prospect[]         @relation("ProspectAssignee")
  staffEvents       StaffEvent[]
  staffTargets      StaffTarget[]
  attendance        AttendanceSession[]
  visits            StaffVisit[]
  commissionRules   CommissionRule[]
  commissionStatements CommissionStatement[]
  assignedRestaurantsSales   Restaurant[] @relation("RestaurantSalesAssignee")
  assignedRestaurantsSupport Restaurant[] @relation("RestaurantSupportAssignee")
  assignedPharmaciesSales    Pharmacy[]   @relation("PharmacySalesAssignee")
  assignedPharmaciesSupport  Pharmacy[]   @relation("PharmacySupportAssignee")

  /// One seat per email per partner. The same person may hold a seat at two
  /// partners — rare, but an HQ operator who also runs a city is exactly that.
  @@unique([partnerId, email])
  @@index([partnerId, status])
  @@map("partner_users")
}

/// An outstanding invitation to a partner portal seat.
model PartnerInvite {
  id        String @id @default(uuid())
  partnerId String
  email     String
  role      String

  /// A SHA-256 of the token, never the token. The token is shown once, in the
  /// email; a leaked database therefore cannot be used to accept invitations.
  /// Same reasoning as the hashed IP in rate_limits.
  tokenHash String @unique

  invitedByUserId String?

  /// The `outbound_emails` row carrying this invitation, or null when none was
  /// queued (no encryption key, so no link could be composed). Deliberately not
  /// a relation: pruning the mail queue must not rewrite invitations, and a
  /// dangling id reads the same as null on the team screen.
  emailId         String?

  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, expiresAt])
  @@map("partner_invites")
}

enum ProspectStage {
  lead
  contacted
  demo_booked
  trial
  paid
  lost
}

enum ProspectSource {
  walk_in
  referral
  lead_form
  ads
  other
}

/// A business a partner is trying to sign, before it is a merchant.
///
/// NOT `prospect_leads` — that is HQ's own OpenStreetMap scraping list, super
/// admin only, with no partner scope. The names are close enough to be worth
/// saying out loud once: this table belongs to a partner, that one to HQ.
///
/// Carries mobile numbers and addresses of people who have not agreed to
/// anything, so it gets the partner_waitlist treatment: no `anon` grant, no
/// `authenticated` grant, every write through a server action.
model Prospect {
  id           String  @id @default(uuid())
  partnerId    String
  businessName String
  ownerName    String?
  /// Normalised to +639XXXXXXXXX on the way in, like the waitlist. Four
  /// spellings of one number is four rows that look like four businesses.
  mobile       String?
  address      String?
  /// Which product is being pitched. A registry id ("servd", "pharmacy"), not a
  /// foreign key — products are code, not a table.
  productId    String

  stage  ProspectStage  @default(lead)
  source ProspectSource @default(other)

  nextFollowUpAt DateTime?
  notes          String?
  assignedToId   String?
  lostReason     String?

  /// Set when the prospect becomes a merchant. Two columns, because a merchant
  /// id is only unique WITHIN a product — the same reason PartnerLedgerEntry
  /// carries productId alongside merchantId.
  convertedMerchantId String?
  convertedProductId  String?
  convertedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner    Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  assignedTo PartnerUser? @relation("ProspectAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([partnerId, stage])
  @@index([partnerId, nextFollowUpAt])
  @@index([assignedToId])
  @@map("prospects")
}

/// A partner's month, frozen.
///
/// Holds ONLY what recomputation cannot produce: the moment the month was
/// closed and the payout status HQ edits. Every number in it is derivable from
/// `partner_ledger_entries` — which is append-only, and carries the share
/// percentage that applied when each payment settled — so this table is a cache
/// of an answer, never the answer. `packages/db/src/statements.ts` owns both.
///
/// Read-only to the partner. A partner able to write here is a partner writing
/// their own statement.
model PartnerStatement {
  id        String @id @default(uuid())
  partnerId String
  /// "2026-06", in Asia/Manila. Every merchant and peso here is in one time
  /// zone, and computing the boundary in UTC puts eight hours of 31 December
  /// into January.
  month     String

  grossCentavos   Int
  partnerCentavos Int
  hqCentavos      Int
  merchantCount   Int

  frozenAt     DateTime  @default(now())
  /// "pending" | "paid" | "overdue". HQ moves it; the portal displays it.
  payoutStatus String    @default("pending")
  paidAt       DateTime?
  /// HQ's note when a payout is late or short. Shown to the partner.
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, month])
  @@index([partnerId, month])
  @@map("partner_statements")
}

/// A partner's price for one plan, above the HQ floor.
///
/// Absent means "charge the plan's own price". A row here is an override, which
/// is why the table is sparse rather than one row per partner per plan — a
/// partner who has never touched pricing should not acquire rows that then have
/// to be kept in step with the catalogue.
model PartnerPlanPrice {
  id              String  @id @default(uuid())
  partnerId       String
  planId          String
  /// Centavos per month. Validated against Plan.priceFloor on write.
  priceMonthly    Int
  /// Apply to merchants already on this plan at their next cycle, not just to
  /// new ones. Stored because the decision is made when the price is set and
  /// acted on later, by the billing pass.
  applyToExisting Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([partnerId, planId])
  @@map("partner_plan_prices")
}

/// One notification channel choice, per user, per event.
model NotificationPref {
  id            String @id @default(uuid())
  /// Denormalised from the user so the RLS policy is a column comparison rather
  /// than a subquery into partner_users. A policy that joins is a policy that
  /// can be got wrong; this one cannot.
  partnerId     String
  partnerUserId String
  /// A key from packages/core/src/partners/notifications.ts.
  event         String

  email     Boolean @default(true)
  /// Messenger is a placeholder — there is no integration yet, and the UI
  /// disables the toggle. The column exists so turning it on later is not a
  /// migration during a launch.
  messenger Boolean @default(false)

  updatedAt DateTime @updatedAt

  user PartnerUser @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)

  @@unique([partnerUserId, event])
  @@index([partnerId])
  @@map("notification_prefs")
}

/// One settled payment, recorded against the partner that owns the merchant.
///
/// D15: the platform's record of what was actually COLLECTED. Not what was
/// invoiced — on a gateway with no auto-charge every merchant is issued an
/// invoice every month whether or not they pay it, so a ledger of issuances
/// would bill partners for money nobody received.
///
/// IMMUTABLE. Rows are appended and never edited; a refund is another row, not a
/// correction to this one. That is what lets a statement for a past month be
/// recomputed and come out the same, instead of drifting as adjustments land.
///
/// NOT MERCHANT-READABLE. It carries the partner/HQ split, which is a commercial
/// term between CANVEXIA and the operator and none of the restaurant's business.
/// packages/db/prisma/rls.sql excludes it from the tenant loop and gives it a partner-only
/// policy — see the comment there.
model PartnerLedgerEntry {
  id            String   @id @default(uuid())
  partnerId     String
  /// Which product the merchant belongs to. Ledger rows outlive the app that
  /// wrote them, and "merchant abc123" means nothing without it once there is
  /// more than one product — ids are unique within a product, not across them
  /// (see ProvisionResult.merchantId).
  productId     String   @default(dbgenerated("'servd'"))
  /// The merchant id WITHIN that product: restaurants.id for servd,
  /// pharmacies.id for pharmacy. Not a foreign key, and cannot be one — the
  /// table it points at depends on productId.
  merchantId    String
  /// Money that ARRIVED: "subscription" | "addon" | "feature" | "activation".
  /// Money moved BY HAND: "credit" | "debit" | "refund" | "waiver".
  /// A referral fee on a national account: "referral".
  ///
  /// The adjustment kinds live on this table rather than a parallel one because
  /// this table is already append-only and immutable and is what
  /// computeStatement reads. A separate adjustments table is how a statement and
  /// its explanation come to disagree.
  kind          String
  /// The gateway reference this settlement came from. UNIQUE, which is what
  /// makes recording idempotent: a replayed webhook — and gateways do replay —
  /// cannot pay a partner twice for one payment.
  providerRef   String   @unique
  /// Centavos actually settled.
  grossAmount   Int
  partnerAmount Int
  hqAmount      Int
  /// The split in force AT THE TIME, snapshotted.
  ///
  /// Load-bearing: without it, renegotiating a partner's percentage would
  /// silently rewrite every statement they have ever been issued. Same reasoning
  /// as the *AtTime columns on orders.
  sharePct      Int
  currency      String   @default(dbgenerated("'PHP'"))
  occurredAt    DateTime @default(now())

  // --- Adjustments only (Phase H1) ------------------------------------------
  // NULL on every settlement row. A CHECK constraint requires both of the first
  // two on the four hand-moved kinds: an adjustment with no reason is an
  // unexplained movement of money, and the person who would have to explain it
  // is not the person who made it.
  /// Why HQ moved this money. Required on credit/debit/refund/waiver.
  adjustmentReason String?
  /// The HQ admin who did it. Required on the same four.
  actorEmail       String?
  /// Optional supporting document, as a private Storage path. Never a URL.
  attachmentPath   String?

  @@index([partnerId, occurredAt])
  @@index([productId, merchantId])
  @@map("partner_ledger_entries")
}

/// Program-wide settings (singleton row id="program").
///
/// Once carried the commission rates, bonus tiers, cookie window, clawback
/// window, minimum payout and withholding %. All of that went with the
/// commission; the training video is the only setting left. The columns still
/// exist in the database (NOT NULL with defaults, so inserts here are fine) —
/// the optional drop script clears them out.
model ProgramSetting {
  id                 String   @id @default("program")
  /// Partner onboarding video shown on the partner dashboard. A YouTube/Vimeo
  /// link or a direct video URL (super-admin sets it).
  partnerTrainingUrl String?
  /// Days after a statement is frozen before its payout or invoice reads as
  /// overdue. Config rather than a constant: "when is this late" is a
  /// commercial decision and changing it should not be a deploy.
  overdueDays        Int      @default(dbgenerated("15"))
  /// HQ's own booking link, used by /hq/applications. Deliberately separate
  /// from canvexia.com's NEXT_PUBLIC_BOOKING_URL — they are different calendars
  /// for different conversations.
  hqBookingUrl       String?
  updatedAt          DateTime @updatedAt

  @@map("program_settings")
}

// ----------------------------------------------------------------------------
// Tables & menu
// ----------------------------------------------------------------------------

enum TableStatus {
  empty
  occupied
  needs_cleaning
  reserved
}

model Table {
  id           String      @id @default(uuid())
  restaurantId String
  tableNumber  String // string so "T1", "Patio-3" etc. are allowed
  qrToken      String      @unique // non-guessable token embedded in the QR
  isCounter    Boolean     @default(false) // a single stall/takeout QR — issues order numbers, not a seat
  status       TableStatus @default(empty) // floor-plan status (occupancy is also derived from open orders)
  posX         Int? // floor-plan layout position
  posY         Int?
  seats        Int? // capacity (optional, used by reservations)
  createdAt    DateTime    @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
  @@map("tables")
}

/// Immutable audit trail — every sensitive change (voids, edits, discounts,
/// status overrides) records who/what/when with before/after snapshots.
model AuditLog {
  id           String   @id @default(uuid())
  /// Nullable since CANVEXIA: an HQ or partner action (approving an operator,
  /// reassigning a merchant, changing a revenue share) has an actor and a
  /// subject but no restaurant. Every existing row has one, and every existing
  /// caller still passes one — writeAudit() takes it as a required argument —
  /// so this widens what can be recorded without changing what is.
  restaurantId String?
  /// Set when the action belongs to a partner rather than to one merchant.
  partnerId    String?
  /// "merchant" | "partner" | "hq" | "system". Null on rows written before the
  /// column existed, which are all merchant actions by construction.
  actorType    String?
  actorStaffId String? // StaffUser.id of who did it (null = system)
  actorEmail   String? // snapshot of the actor's email for display
  /// The role the actor held AT THE TIME. Snapshotted for the same reason
  /// actorEmail is: a seat promoted to admin next month must not retroactively
  /// make every action it ever took an admin action.
  actorRole    String?
  action       String // e.g. "order.void", "order.item_void", "table.status"
  entityType   String // "order", "table", "order_item", …
  entityId     String?
  reason       String? // mandatory reason code/text for approvals
  before       Json? // snapshot before the change
  after        Json? // snapshot after the change
  createdAt    DateTime @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@index([restaurantId, entityType, entityId])
  @@index([partnerId, createdAt])
  @@map("audit_logs")
}

model Category {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]
  translations CategoryTranslation[]

  @@index([restaurantId])
  @@map("categories")
}

model CategoryTranslation {
  id           String @id @default(uuid())
  restaurantId String
  categoryId   String
  locale       String // e.g. "fil"
  name         String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([restaurantId])
  @@map("category_translations")
}

model MenuItem {
  id             String   @id @default(uuid())
  restaurantId   String // denormalized for RLS + simple tenant scoping
  categoryId     String
  name           String
  description    String?
  price          Int // centavos
  imageUrl       String?
  videoUrl       String? // uploaded file URL or a YouTube/Vimeo/direct link
  videoPosterUrl String? // optional poster; UI falls back to imageUrl
  isAvailable    Boolean  @default(true) // false => out of stock
  /// Counter-only: the cashier can punch it, the website never shows it and
  /// the diner order builder refuses it. For the things a menu shouldn't
  /// advertise but a till still has to ring up — a takeaway box charged by
  /// size, an add-on somebody wants three of, a staff meal, a dessert that
  /// doesn't survive a delivery ride.
  ///
  /// Nullable with no default: it ships as a hand-run migration, and a
  /// defaulted column would go into the INSERT of every menu item created
  /// before that migration is run. Treat null as false.
  posOnly        Boolean?
  dietaryTags    String[] @default([]) // diet/allergen tag keys (see src/lib/menu/dietary.ts)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  restaurant       Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category         Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups   MenuItemModifierGroup[]
  orderItems       OrderItem[]
  translations     MenuItemTranslation[]
  recipeComponents RecipeComponent[]
  foodCost         MenuItemCost?
  serving          MenuItemServing?
  variants         MenuItemVariant[]
  stock            InventoryItem? // present when this product's own units are counted

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

// Per-item sizes/variants (e.g. fish/pork sold by size or weight): one item with
// several named options, each its own absolute price (centavos). The chosen
// variant replaces the item's base price — separate from modifiers. Own table so
// existing menu_items reads stay safe on a lagging DB.
model MenuItemVariant {
  id           String   @id @default(uuid())
  restaurantId String
  menuItemId   String
  name         String // "Small", "1/2 kilo", "Large", …
  price        Int // absolute price in centavos
  stock        Int? // pcs available for this size; null = untracked, 0 = sold out
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@index([restaurantId])
  @@map("menu_item_variants")
}

// Per-item daily servings cap (e.g. "only 5 of these per day"). Lives in its own
// table so existing menu_items reads stay safe on a lagging DB. `soldToday` is
// reset lazily against `soldOn` (the Manila day key) when counted.
model MenuItemServing {
  menuItemId   String   @id
  restaurantId String
  dailyLimit   Int? // null = unlimited (no cap)
  soldToday    Int      @default(0)
  soldOn       String? // Manila day key (YYYY-MM-DD) the count belongs to
  updatedAt    DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("menu_item_servings")
}

model MenuItemTranslation {
  id           String  @id @default(uuid())
  restaurantId String
  menuItemId   String
  locale       String
  name         String
  description  String?

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, locale])
  @@index([restaurantId])
  @@map("menu_item_translations")
}

model ModifierGroup {
  id           String   @id @default(uuid())
  restaurantId String
  name         String // "Size", "Add-ons", "Spice level"
  required     Boolean  @default(false)
  minSelect    Int      @default(0)
  maxSelect    Int      @default(1) // 1 => single-select, >1 => multi-select
  /// The order these appear in, everywhere, for every item that uses them.
  ///
  /// Set once on the Modifiers page. Without it the order came off the
  /// item↔group link, whose sortOrder was never written — so every row tied at
  /// 0 and Postgres returned them in whatever order it liked, which is why one
  /// item asked Size → Flavour → Add-ons and the next asked Flavour → Add-ons
  /// → Size.
  ///
  /// Nullable with NO default: a static default would be sent by Prisma on
  /// every insert and break creates on a database that lacks the column. Null
  /// sorts last, behind everything explicitly ordered.
  sortOrder    Int?
  createdAt    DateTime @default(now())

  restaurant Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  modifiers  Modifier[]
  menuItems  MenuItemModifierGroup[]

  @@index([restaurantId])
  @@map("modifier_groups")
}

model Modifier {
  id              String  @id @default(uuid())
  modifierGroupId String
  name            String // "Large", "Extra cheese"
  priceDelta      Int     @default(0) // centavos; +30, +20, can be negative
  sortOrder       Int     @default(0)
  isAvailable     Boolean @default(true) // false = marked out (add-on ran out)

  group ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@index([modifierGroupId])
  @@map("modifiers")
}

// join: which modifier groups apply to which menu item
model MenuItemModifierGroup {
  menuItemId      String
  modifierGroupId String
  sortOrder       Int    @default(0)

  menuItem MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  group    ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
  @@map("menu_item_modifier_groups")
}

// ----------------------------------------------------------------------------
// Inventory module (plan-gated by `inventory`)
// ----------------------------------------------------------------------------

enum StockReason {
  sale // auto-deducted when an order is marked done
  waste
  received // from a purchase order
  adjustment // manual correction
  count // reconciled by a stock count
  usage // manually taken/requested for use (prep, staff meal, etc.)
}

enum PurchaseOrderStatus {
  draft
  ordered
  received
  cancelled
}

model Supplier {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  contactJson  Json?
  createdAt    DateTime @default(now())

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]

  @@index([restaurantId])
  @@map("suppliers")
}

model InventoryItem {
  id                String    @id @default(uuid())
  restaurantId      String
  name              String
  unit              String // "kg", "pc", "ml", …
  stockQty          Float     @default(0)
  costPerUnit       Int       @default(0) // centavos (weighted-average)
  reorderLevel      Float     @default(0)
  lowStockAlertedAt DateTime? // set when a low-stock alert was sent; cleared on restock
  supplierId        String?
  // Set => this row IS a product's own stock, not an ingredient. A restaurant
  // tracks flour and sells dishes made from it; a shop tracks the thing it
  // sells. Both are stock, so both live here and share movements, costing,
  // purchase orders and reorder alerts — the link is what tells them apart.
  menuItemId        String?   @unique
  createdAt         DateTime  @default(now())

  restaurant       Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier         Supplier?           @relation(fields: [supplierId], references: [id])
  menuItem         MenuItem?           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  movements        StockMovement[]
  recipeComponents RecipeComponent[]
  poItems          PurchaseOrderItem[]

  @@index([restaurantId])
  @@map("inventory_items")
}

model RecipeComponent {
  id              String @id @default(uuid())
  restaurantId    String
  menuItemId      String
  inventoryItemId String
  quantity        Float // amount consumed per 1 of the menu item

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, inventoryItemId])
  @@index([restaurantId])
  @@map("recipe_components")
}

model StockMovement {
  id              String      @id @default(uuid())
  restaurantId    String
  inventoryItemId String
  changeQty       Float // negative = consumed, positive = added
  reason          StockReason
  unitCost        Int? // cost/unit at the time (centavos) — for COGS
  refId           String? // orderId / purchaseOrderId / etc.
  note            String?
  createdAt       DateTime    @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@index([inventoryItemId])
  @@map("stock_movements")
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  restaurantId String
  supplierId   String?
  status       PurchaseOrderStatus @default(draft)
  createdAt    DateTime            @default(now())
  receivedAt   DateTime?

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier   Supplier?           @relation(fields: [supplierId], references: [id])
  items      PurchaseOrderItem[]

  @@index([restaurantId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(uuid())
  restaurantId    String
  purchaseOrderId String
  inventoryItemId String
  quantity        Float
  unitCost        Int // centavos

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([restaurantId])
  @@map("purchase_order_items")
}

// ----------------------------------------------------------------------------
// HRIS module (plan-gated by `hris`)
// ----------------------------------------------------------------------------

enum EmploymentType {
  full_time
  part_time
  contract
}

enum PayType {
  hourly
  daily
  monthly
}

enum EmployeeStatus {
  active
  inactive
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum SwapStatus {
  pending
  approved
  rejected
}

model Employee {
  id             String         @id @default(uuid())
  restaurantId   String
  staffUserId    String?        @unique // optional link to an app login
  fullName       String
  title          String?
  employmentType EmploymentType @default(full_time)
  payRate        Int            @default(0) // centavos (per hour or per month)
  payType        PayType        @default(hourly)
  hiredAt        DateTime?
  contactJson    Json? // phone, address, emergency contact …
  status         EmployeeStatus @default(active)
  clockPin       String? // PIN for login + clock-in at a station
  clockToken     String         @unique @default(uuid()) // for personal-QR clock-in
  createdAt      DateTime       @default(now())

  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  documents     EmployeeDocument[]
  shifts        Shift[]
  availability  Availability[]
  timeEntries   TimeEntry[]
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  swapRequests  ShiftSwapRequest[]
  deductions    PayrollDeduction[]

  @@index([restaurantId])
  @@map("employees")
}

/// A one-off payroll deduction entered by hand (cash advance, loan, uniform,
/// breakage…). Applies to whichever payroll period `appliedOn` falls in, so it
/// shows up once and never repeats.
model PayrollDeduction {
  id           String   @id @default(uuid())
  restaurantId String
  employeeId   String
  label        String
  amount       Int // centavos
  appliedOn    DateTime // date this belongs to (matched against the payroll period)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId, appliedOn])
  @@index([employeeId])
  @@map("payroll_deductions")
}

model EmployeeDocument {
  id           String   @id @default(uuid())
  restaurantId String
  employeeId   String
  name         String
  url          String
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("employee_documents")
}

model Shift {
  id           String   @id @default(uuid())
  restaurantId String
  employeeId   String? // null = open/unassigned shift
  startsAt     DateTime
  endsAt       DateTime
  role         String?
  notes        String?
  createdAt    DateTime @default(now())

  employee     Employee?          @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  swapRequests ShiftSwapRequest[]

  @@index([restaurantId, startsAt])
  @@map("shifts")
}

model Availability {
  id           String @id @default(uuid())
  restaurantId String
  employeeId   String
  dayOfWeek    Int // 0=Sun … 6=Sat
  startMinute  Int // minutes from midnight
  endMinute    Int

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("availabilities")
}

model ShiftSwapRequest {
  id           String     @id @default(uuid())
  restaurantId String
  shiftId      String
  employeeId   String // who requested
  status       SwapStatus @default(pending)
  note         String?
  createdAt    DateTime   @default(now())

  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("shift_swap_requests")
}

model TimeEntry {
  id               String    @id @default(uuid())
  restaurantId     String
  employeeId       String
  clockIn          DateTime
  clockOut         DateTime?
  breakMinutes     Int       @default(0)
  source           String    @default("qr") // qr | pin | selfie
  approved         Boolean   @default(false)
  clockInPhotoUrl  String? // storage path of the clock-in selfie
  clockOutPhotoUrl String? // storage path of the clock-out selfie
  createdAt        DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId, clockIn])
  @@index([employeeId])
  @@map("time_entries")
}

model LeaveType {
  id           String  @id @default(uuid())
  restaurantId String
  name         String
  isPaid       Boolean @default(true)

  requests LeaveRequest[]
  balances LeaveBalance[]

  @@index([restaurantId])
  @@map("leave_types")
}

model LeaveRequest {
  id           String      @id @default(uuid())
  restaurantId String
  employeeId   String
  leaveTypeId  String
  startDate    DateTime
  endDate      DateTime
  status       LeaveStatus @default(pending)
  approverId   String?
  note         String?
  createdAt    DateTime    @default(now())

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("leave_requests")
}

model LeaveBalance {
  id           String @id @default(uuid())
  restaurantId String
  employeeId   String
  leaveTypeId  String
  balance      Float  @default(0) // days

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId])
  @@index([restaurantId])
  @@map("leave_balances")
}

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------

enum OrderType {
  dine_in
  takeout // ordered at the counter, taking it away
  pickup // ordered ahead, collecting it
  delivery
  third_party // Grab / Foodpanda and similar
}

model Order {
  id                  String        @id @default(uuid())
  restaurantId        String
  tableId             String?
  orderType           OrderType     @default(dine_in)
  orderNumber         Int? // daily ticket number for counter/stall orders (resets daily)
  customerName        String? // for pickup / delivery
  customerPhone       String?
  customerAddress     String? // for delivery
  customerLat         Float? // pinned delivery location
  customerLng         Float?
  deliveryStatus      String? // null → out_for_delivery → delivered
  status              OrderStatus   @default(new)
  billRequested       Boolean       @default(false)
  paymentStatus       PaymentStatus @default(unpaid)
  total               Int           @default(0) // centavos (gross subtotal)
  discountAmount      Int           @default(0) // centavos taken off (senior/PWD/custom)
  discountLabel       String? // e.g. "Senior Citizen (20%)"
  creditApplied       Int           @default(0) // centavos paid by a redeemed gift card / store credit
  giftCardId          String? // the gift card credit was redeemed from
  tipAmount           Int           @default(0) // centavos gratuity added at online checkout
  /// Fee added on top for paying by card, in centavos, and what to call it on
  /// the receipt. Written when the card tender is taken, so it reflects the
  /// rate in force at that moment rather than whatever the settings say later.
  ///
  /// Nullable with no default on purpose: a defaulted column is one Prisma
  /// writes into the INSERT of every order, and this ships as a hand-run
  /// migration. Treat null as zero.
  surchargeAmount     Int?
  surchargeLabel      String?
  inventoryDeductedAt DateTime? // set once stock is deducted (idempotency)
  servedAt            DateTime? // set when the cashier confirms the food was served
  /// A second round: the table ate, asked for more, and the cashier punched it
  /// onto the same bill. Stamped every time items are appended to an order that
  /// already existed, so the kitchen card can say "these are extras" instead of
  /// looking like a ticket the cook has somehow already made most of.
  ///
  /// Nullable with no default — it ships as a hand-run migration, and a
  /// defaulted column is one Prisma writes into the INSERT of every order.
  addedItemsAt        DateTime?
  voidedAt            DateTime? // set when a cashier voids the (unpaid) order
  prepMinutes         Int? // prep-time estimate (minutes) a merchant sets on accept
  /// When the order was accepted, which is where prepMinutes counts down FROM.
  ///
  /// A duration on its own is not a deadline. Without this the merchant screen
  /// could only show a static "~20m", and the moment of acceptance cannot be
  /// inferred from createdAt: an advance order booked this morning would read
  /// as hours late the instant somebody accepted it.
  ///
  /// Nullable with no default — it ships as a hand-run migration, and an order
  /// accepted before that ran genuinely has no known acceptance time. Null
  /// means no countdown, rather than a made-up one.
  acceptedAt          DateTime?
  cancelReason        String? // reason a merchant rejected the order
  scheduledFor        DateTime? // advance order: requested pickup/delivery time (null = ASAP)
  approvalStatus      String? // advance order: awaiting | approved | declined (null = not an advance order)
  downpaymentAmount   Int? // centavos owner requires up-front to confirm an advance order
  downpaymentRef      String? // customer's payment reference (e.g. GCash ref) for the downpayment
  downpaymentPaid     Boolean       @default(false) // owner confirmed the downpayment landed
  paymentChoice       String? // website order's chosen method: "cod" | "gcash" (null = not set)
  paymentRef          String? // customer's GCash reference for the full payment
  paymentReceiptUrl   String? // uploaded screenshot of the customer's online payment
  /// What the customer says they'll hand over, on a cash order — so the
  /// cashier can count the change before the rider or the customer arrives
  /// instead of asking at the door. Centavos.
  cashTendered        Int?
  customerNote        String? // customer's note to the rider / kitchen (online orders)
  source              String? // where the order came from: "web" (online site) | null (dine-in/POS)
  /// The cashier who opened this order, shown on the floor so a table can be
  /// traced back to whoever rang it up. Attribution only — every cashier can
  /// still settle every table, or a customer would be stranded the moment the
  /// staff member who served them went on break.
  openedByStaffId     String?
  openedByName        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table?      @relation(fields: [tableId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  feedback   Feedback[]

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt]) // date-range analytics
  @@index([restaurantId, orderNumber]) // daily counter-number lookup
  @@index([tableId])
  @@map("orders")
}

/// Per-restaurant third-party delivery provider config. Standalone (no Prisma
/// relation) so existing restaurant reads stay safe on a lagging DB; the FK is
/// enforced in packages/db/prisma/manual/add-delivery-bookings.sql.
model DeliverySettings {
  id               String   @id @default(uuid())
  restaurantId     String   @unique
  provider         String   @default("manual") // manual | deeplink | api
  providerKey      String? // informational, e.g. "lalamove"
  deepLinkTemplate String? // URL template with {pickup}/{dropoff}/… tokens
  apiBaseUrl       String?
  credentialsEnc   String? // AES-GCM encryptJson({ apiKey, webhookSecret })
  enabled          Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("delivery_settings")
}

/// A third-party rider booking attached to a delivery order. One per order.
model DeliveryBooking {
  id              String    @id @default(uuid())
  restaurantId    String
  orderId         String    @unique
  provider        String // manual | deeplink | api
  providerKey     String?
  bookingRef      String? // the provider's booking id
  status          String    @default("manual") // searching|assigned|picked_up|delivered|cancelled|failed|manual
  fee             Int? // centavos
  etaMinutes      Int?
  riderName       String?
  riderPhone      String?
  riderLat        Float?
  riderLng        Float?
  trackingUrl     String?
  /// Set when the rider says they are at the door. Not a status on the
  /// provider's side either — it happens during "out for delivery" and the
  /// delivery is not over until somebody hands the food across.
  arrivedAt       DateTime?
  /// The last thing the rider said to this diner, kept only so the tracker can
  /// show and announce it. The conversation itself lives on the provider's
  /// tracking page; this is a doorbell, not a second inbox.
  lastMessageAt   DateTime?
  lastMessageBody String?
  raw             Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([restaurantId])
  @@index([bookingRef])
  @@map("delivery_bookings")
}

/// Shift handover notes — free-text left by one shift for the next.
model ShiftNote {
  id            String   @id @default(uuid())
  restaurantId  String
  authorStaffId String?
  authorName    String?
  body          String
  createdAt     DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("shift_notes")
}

/// Online-ordering cart leads — captured when a diner enters their phone at
/// checkout. If the order isn't placed, a cron sends a recovery message.
model CartLead {
  id            String    @id @default(uuid())
  restaurantId  String
  customerName  String?
  customerPhone String
  itemCount     Int       @default(0)
  total         Int       @default(0) // centavos
  status        String    @default("open") // open | converted | recovered
  recoveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([restaurantId, customerPhone])
  @@map("cart_leads")
}

/// Reservations & waitlist. A booking with a time is a reservation; a `null`
/// reservedAt with status "waitlisted" is a walk-in waiting for a table.
model Reservation {
  id            String    @id @default(uuid())
  restaurantId  String
  customerName  String
  customerPhone String?
  partySize     Int       @default(2)
  reservedAt    DateTime? // the booked slot; null = waitlist (no set time)
  durationMin   Int       @default(90)
  status        String    @default("booked") // booked | seated | cancelled | no_show | waitlisted
  tableId       String? // soft link to a table (no FK — table may be removed)
  note          String?
  source        String? // "online" = self-booked from the website; null = staff-entered
  createdAt     DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, reservedAt])
  @@index([restaurantId, status])
  @@map("reservations")
}

/// Prepaid gift cards / store credit. Balance is server-authoritative — every
/// load/redeem is a GiftCardTxn and the running balance is recomputed from them
/// (the stored `balance` is a cache).
model GiftCard {
  id             String    @id @default(uuid())
  restaurantId   String
  code           String // redemption code (unique per restaurant, case-insensitive)
  initialBalance Int // centavos issued
  balance        Int // centavos remaining
  customerPhone  String? // optional owner
  customerName   String?
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transactions GiftCardTxn[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("gift_cards")
}

/// Ledger of gift-card movements (issue / redeem / restore) for audit + balance.
model GiftCardTxn {
  id           String   @id @default(uuid())
  restaurantId String
  giftCardId   String
  amount       Int // centavos: positive = load/restore, negative = redeem
  kind         String // "issue" | "redeem" | "restore"
  orderId      String?
  createdAt    DateTime @default(now())

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId])
  @@map("gift_card_txns")
}

/// Happy hour / scheduled pricing — time-windowed automatic discounts applied
/// to selected items or categories. Server-authoritative: the discount is
/// recomputed at order time (and shown on the menu), never trusted from the client.
model HappyHour {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  discountType String   @default("percent") // "percent" | "amount"
  value        Int      @default(0) // percent (1-100) or centavos off the item's base price
  scope        String   @default("all") // "all" | "category" | "item"
  targetIds    String[] @default([]) // category ids or item ids when scoped
  days         Int[]    @default([]) // 0=Sun..6=Sat; empty = every day
  startMinute  Int      @default(0) // minutes from midnight (Asia/Manila)
  endMinute    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, active])
  @@map("happy_hours")
}

/// Marketing promotions shown to diners in the app's "Promos" section. Managed
/// by the restaurant from the admin dashboard.
model Promotion {
  id           String    @id @default(uuid())
  restaurantId String
  title        String
  description  String?
  // Coupon redemption: customers enter `code` at checkout to get the offer.
  code         String? // customizable coupon code (unique per restaurant, case-insensitive)
  type         String    @default("info") // info | percent | amount | free_delivery | free_item | bogo
  value        Int       @default(0) // percent (1-100) OR centavos off, depending on type
  freeItemId   String? // menu item for free_item / bogo
  minSpend     Int       @default(0) // centavos: minimum order subtotal to qualify
  expiresAt    DateTime? // optional auto-expiry
  active       Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, active])
  @@index([restaurantId, code])
  @@map("promotions")
}

model OrderItem {
  id             String    @id @default(uuid())
  orderId        String
  menuItemId     String? // nullable: kept as SetNull so deleting a menu item/category
  //          preserves order history (name & price are snapshotted below).
  nameAtTime     String // snapshot of item name
  quantity       Int       @default(1)
  unitPrice      Int // snapshot of base price (centavos)
  note           String?
  /// Ticked off by the kitchen as it goes out — the line is struck through on
  /// every tablet so the pass can see what is still to come. Purely a working
  /// aid: it doesn't move the order's status or touch stock.
  ///
  /// Nullable, no default. Both of these ship as hand-run migrations, and a
  /// defaulted column is one Prisma writes into the INSERT of every order item.
  preparedAt     DateTime?
  /// How many of this line were refunded, and what was handed back (centavos).
  /// Null means none. The money itself is a negative payment row, so the day's
  /// takings need no special-casing anywhere.
  refundedQty    Int?
  refundedAmount Int?

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem  MenuItem?           @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id               String @id @default(uuid())
  orderItemId      String
  modifierId       String
  nameAtTime       String // snapshot of modifier name
  priceDeltaAtTime Int // snapshot of price delta (centavos)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

/// Queue for the "cloud" / server-direct print transport: the printer polls an
/// endpoint and pulls pending jobs (ESC/POS, base64). Also records jobs for the
/// network transport for auditing.
model PrintJob {
  id            String      @id @default(uuid())
  restaurantId  String
  orderId       String?
  method        PrintMethod
  payloadBase64 String // ESC/POS bytes, base64
  status        String      @default("queued") // queued | printed | failed
  // Which printer this is for: "till" (default) or "kitchen", when a restaurant
  // runs a second printer at the pass. Nullable with NO default — a static
  // default would be sent by Prisma on every insert and break printing on a
  // database that lacks the column. Null reads as the till, which is what every
  // job was before a second printer existed.
  station       String?
  createdAt     DateTime    @default(now())
  printedAt     DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@map("print_jobs")
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String
  amount      Int // centavos
  method      PaymentMethod
  gateway     Gateway
  gatewayRef  String? // gateway's checkout/intent id
  status      PaymentStatus @default(pending)
  /// Which cashier took this money, and during which shift. Null for online
  /// payments (no cashier touched them) and for anything recorded before
  /// shift tracking existed — the summary treats both as "not in my drawer".
  staffUserId String?
  shiftId     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([shiftId])
  @@map("payments")
}

// ----------------------------------------------------------------------------
// Feedback & reputation  (NO sentiment gating — see google_invite_shown)
// ----------------------------------------------------------------------------

model Feedback {
  id                String   @id @default(uuid())
  restaurantId      String
  orderId           String?
  rating            Int // 1-5 stars
  comment           String?
  // The Google review invite is shown to EVERYONE regardless of rating.
  googleInviteShown Boolean  @default(false)
  googleClick       Boolean  @default(false)
  createdAt         DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([restaurantId, createdAt]) // rating-trend analytics
  @@map("feedback")
}

// ----------------------------------------------------------------------------
// SMS marketing  (POST-MVP — schema defined now, features built later)
// ----------------------------------------------------------------------------

model CustomerContact {
  id               String           @id @default(uuid())
  restaurantId     String
  phone            String
  name             String?
  marketingConsent MarketingConsent @default(none)
  // Proof of consent — store exactly what was shown and where.
  consentText      String?
  consentSource    String? // "payment_screen" | "feedback_screen"
  optInAt          DateTime?
  confirmedAt      DateTime?
  optOutAt         DateTime?
  createdAt        DateTime         @default(now())

  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  smsMessages SmsMessage[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@map("customer_contacts")
}

model SmsCampaign {
  id             String    @id @default(uuid())
  restaurantId   String
  body           String
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int       @default(0)
  createdAt      DateTime  @default(now())

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  messages   SmsMessage[]

  @@index([restaurantId])
  @@map("sms_campaigns")
}

model SmsMessage {
  id          String   @id @default(uuid())
  campaignId  String
  contactId   String
  status      String // queued | sent | delivered | failed
  providerRef String?
  createdAt   DateTime @default(now())

  campaign SmsCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  CustomerContact @relation(fields: [contactId], references: [id])

  @@index([campaignId])
  @@map("sms_messages")
}

model SmsCreditLedger {
  id           String   @id @default(uuid())
  restaurantId String
  change       Int // +credits purchased, -credits used
  reason       String
  balanceAfter Int
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("sms_credit_ledger")
}

// ----------------------------------------------------------------------------
// Platform announcements
// ----------------------------------------------------------------------------

/// Something the platform owner needs every restaurant to see — a bug being
/// fixed, planned downtime, a new feature.
///
/// Deliberately its own table rather than a column on anything existing: a new
/// table can be missing entirely without breaking a single existing query,
/// which is the safest shape for something added to a live system.
model Announcement {
  id          String    @id @default(uuid())
  title       String
  body        String
  /// info | warning | incident — drives the colour, not the behaviour.
  level       String    @default("info")
  /// Null while a draft. Set when it goes out; only published ones are shown.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reads AnnouncementRead[]

  @@index([publishedAt])
  @@map("announcements")
}

/// One row per person per announcement they've read.
///
/// Per STAFF USER, not per restaurant: the badge is telling one person there's
/// something they haven't seen, and a manager reading it shouldn't clear it for
/// the owner who hasn't.
model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String
  staffUserId    String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, staffUserId])
  @@index([staffUserId])
  @@map("announcement_reads")
}

// ============================================================================
// RESCETA — pharmacy (product id "pharmacy")
//
// The second product on this schema, and the first written here rather than
// retrofitted (D24). Everything below is derived from jobanica/Pharmacy, a
// working MVP, rather than invented: the batch/expiry model, FEFO dispensing,
// and the statutory Senior Citizen / PWD arithmetic are domain facts that would
// have been got wrong by guessing. What is NOT carried over is that repo's
// tenancy — organizations/branches/memberships with Supabase-Auth RLS — which is
// replaced wholesale by the CANVEXIA partner axis. That replacement is the
// reason D24 says rebuild rather than migrate.
//
// TENANCY: every table here carries `pharmacyId`, exactly as Servd's carry
// `restaurantId`. rls.sql loops over both axes; see MERCHANT_AXES in
// packages/core. A pharmacy's owner is `Pharmacy.partnerId`, the same column
// name and the same meaning as `Restaurant.partnerId`.
//
// TABLE NAMES are all prefixed `pharmacy_`. Servd already owns `categories`,
// `suppliers` and `products` in this schema, and three of those names are ones
// a pharmacy wants too. One schema for every product (D25) makes the namespace
// shared, so the prefix is the cost of that decision, paid here.
//
// MONEY is centavos, everywhere, as integers — same as Servd.
// ============================================================================

enum PharmacyStaffRole {
  owner
  manager
  /// Licensed pharmacist. The only role permitted to dispense a prescription
  /// item in PH practice; the gate is enforced in code, not by this enum.
  pharmacist
  cashier
}

enum PharmacyMovementType {
  receive
  sale
  adjustment
  /// The whole sale reversed. Stock goes back to the exact batches it left.
  void
  /// A customer brought something back. Whether the stock goes back on the
  /// shelf is a separate question — see PharmacyReturnDisposition.
  return
  expiry_writeoff
}

/// What happened to the goods a customer brought back.
///
/// THE DEFAULT IS `destroyed`, and that is a pharmacy fact rather than a
/// preference. Once a medicine has left the premises nobody can verify how it
/// was stored or whether the pack was tampered with, so it cannot go back into
/// saleable stock. A shop can restock a returned kettle; a pharmacy cannot
/// restock a returned box of antibiotics.
///
/// `restocked` exists for the case that genuinely happens — a sealed item
/// handed back across the counter before the customer left — and it is a
/// deliberate choice someone makes per line, never the default.
enum PharmacyReturnDisposition {
  destroyed
  restocked
}

enum PharmacySaleStatus {
  completed
  voided
}

/// `sc` and `pwd` are the two statutory discounts, and they are not ordinary
/// percentage discounts — see the note on PharmacySale.discountAmount.
enum PharmacyDiscountType {
  none
  manual
  sc
  pwd
}

/// A pharmacy merchant. The pharmacy equivalent of Restaurant.
///
/// `partnerId` is the ownership axis and the whole point: it exists before the
/// first row, so there is no backfill, no grandfathering and no reconciling a
/// tenancy model that predates it. That is what D24 bought by rebuilding.
model Pharmacy {
  id        String  @id @default(uuid())
  /// The CANVEXIA partner that owns this merchant. Same meaning as
  /// Restaurant.partnerId; the RLS partner arm resolves through it.
  partnerId String?
  name      String
  slug      String  @unique
  /// active | suspended | pending
  status    String  @default(dbgenerated("'pending'"))

  displayName String?
  logoUrl     String?
  tagline     String?
  address     String?
  phone       String?
  email       String?

  /// FDA Licence to Operate number. Displayed on the receipt; PH pharmacies
  /// must show it. Nullable because a merchant is created before it is chased.
  fdaLtoNumber String?
  /// The supervising pharmacist's PRC licence number, shown on the receipt.
  prcLicenseNo String?
  /// BIR Taxpayer Identification Number.
  tin          String?
  /// VAT rate as a whole percent. 12 in the Philippines, and a column rather
  /// than a constant because the SC/PWD arithmetic divides by it — a rate
  /// change must not mean a code change to a statutory calculation.
  vatRatePct   Int     @default(dbgenerated("12"))

  /// Next receipt number. BIR requires receipts to be gapless and sequential,
  /// so this is incremented inside the sale transaction, not derived by
  /// counting rows (which would reuse a number after a delete).
  nextReceiptNo Int @default(dbgenerated("1"))

  /// Next credit-note number, for returns. Its OWN series, not shared with
  /// receipts: a credit note and a receipt are different documents and BIR
  /// wants each sequence gapless on its own terms.
  nextReturnNo Int @default(dbgenerated("1"))

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The partner SEAT that signed and supports this merchant. Same meaning as
  /// Restaurant.assignedSalesUserId; two columns on two tables because there
  /// are two merchant tables (D29).
  assignedSalesUserId   String?
  assignedSupportUserId String?

  assignedSales   PartnerUser? @relation("PharmacySalesAssignee", fields: [assignedSalesUserId], references: [id], onDelete: SetNull)
  assignedSupport PartnerUser? @relation("PharmacySupportAssignee", fields: [assignedSupportUserId], references: [id], onDelete: SetNull)

  staff      PharmacyStaff[]
  categories PharmacyCategory[]
  products   PharmacyProduct[]
  suppliers  PharmacySupplier[]
  batches    PharmacyBatch[]
  movements  PharmacyStockMovement[]
  sales      PharmacySale[]
  returns    PharmacyReturn[]

  @@index([partnerId])
  @@index([assignedSalesUserId])
  @@map("pharmacies")
}

/// A login at one pharmacy. Mirrors StaffUser: the auth user lives in Supabase,
/// this row is the membership and the role.
model PharmacyStaff {
  id          String            @id @default(uuid())
  pharmacyId  String
  authUserId  String
  role        PharmacyStaffRole
  email       String
  displayName String?
  createdAt   DateTime          @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, authUserId])
  @@unique([pharmacyId, email])
  @@index([authUserId])
  @@map("pharmacy_staff")
}

model PharmacyCategory {
  id         String   @id @default(uuid())
  pharmacyId String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  pharmacy Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  products PharmacyProduct[]

  @@index([pharmacyId])
  @@map("pharmacy_categories")
}

/// A sellable item. The SELLING price lives here; COST lives on the batch,
/// because two deliveries of the same drug are routinely bought at different
/// prices and margin is only meaningful per batch.
model PharmacyProduct {
  id         String  @id @default(uuid())
  pharmacyId String
  categoryId String?

  /// What is on the box, e.g. "Biogesic 500mg".
  name        String
  /// The molecule, e.g. "Paracetamol". Separate because PH pharmacies are
  /// required to offer the generic equivalent, and staff search by it.
  genericName String?
  /// Dosage form: tablet, capsule, syrup, suspension, ointment…
  form        String?
  /// e.g. "500mg", "250mg/5mL".
  strength    String?
  sku         String?
  barcode     String?
  /// The unit a single sale line is counted in — piece, bottle, box, sachet.
  unit        String  @default(dbgenerated("'piece'"))

  /// Rx-only. Dispensing one without a prescription is an offence, so this is
  /// a hard gate in the sale path rather than a warning in the UI.
  requiresPrescription Boolean @default(false)
  /// Below this on-hand quantity the product is reported as low stock.
  reorderPoint         Int     @default(0)
  /// Centavos. VAT-INCLUSIVE, which is what the shelf label says and what the
  /// SC/PWD formula expects to be handed.
  priceCentavos        Int     @default(0)
  isActive             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy  Pharmacy                @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  category  PharmacyCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  batches   PharmacyBatch[]
  movements PharmacyStockMovement[]
  saleItems PharmacySaleItem[]

  @@unique([pharmacyId, sku])
  @@unique([pharmacyId, barcode])
  @@index([pharmacyId])
  @@index([pharmacyId, genericName])
  @@index([categoryId])
  @@map("pharmacy_products")
}

model PharmacySupplier {
  id            String   @id @default(uuid())
  pharmacyId    String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  createdAt     DateTime @default(now())

  pharmacy Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  batches  PharmacyBatch[]

  @@index([pharmacyId])
  @@map("pharmacy_suppliers")
}

/// One delivery of one product, with its own lot number and expiry date.
///
/// THE table that makes this a pharmacy system rather than a shop system.
/// Stock is not a number on the product: it is the sum of unexpired batches,
/// and dispensing draws from the batch expiring soonest (FEFO). Without this
/// the system cannot answer "what expires next month", which is the question
/// the whole category exists to answer.
model PharmacyBatch {
  id         String  @id @default(uuid())
  pharmacyId String
  productId  String
  supplierId String?

  /// The manufacturer's lot number, as printed. Needed for a recall: a recall
  /// names a lot, not a product.
  lotNumber    String?
  expiryDate   DateTime?
  /// Units remaining in this batch. Never negative.
  quantity     Int       @default(0)
  /// Centavos paid per unit for THIS delivery. Snapshotted onto the sale line
  /// so margin stays correct when the next delivery costs something else.
  costCentavos Int       @default(0)
  receivedAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  pharmacy  Pharmacy                @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product   PharmacyProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier  PharmacySupplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements PharmacyStockMovement[]
  saleItems PharmacySaleItem[]

  @@index([pharmacyId])
  @@index([productId, expiryDate])
  @@index([pharmacyId, expiryDate])
  @@map("pharmacy_batches")
}

/// Append-only stock ledger. Every change to a batch quantity writes one.
///
/// The batch quantity is the balance; this is the statement that explains it.
/// Keeping both is deliberate — a discrepancy between them is a bug you can
/// see, and a regulator asking "where did these forty tablets go" needs the
/// statement, not the balance.
model PharmacyStockMovement {
  id            String               @id @default(uuid())
  pharmacyId    String
  productId     String
  batchId       String?
  type          PharmacyMovementType
  /// Signed. Negative for a sale or a write-off, positive for a delivery.
  quantityDelta Int
  /// The sale (or other document) that caused it. Not a foreign key: the
  /// referent depends on `type`.
  referenceId   String?
  reason        String?
  actorStaffId  String?
  createdAt     DateTime             @default(now())

  pharmacy Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product  PharmacyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch    PharmacyBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([pharmacyId, createdAt])
  @@index([productId])
  @@index([batchId])
  @@map("pharmacy_stock_movements")
}

model PharmacySale {
  id            String @id @default(uuid())
  pharmacyId    String
  /// Gapless per pharmacy, allocated inside the sale transaction. BIR wants a
  /// sequence with no holes; counting rows would reuse a number after a void.
  receiptNumber String

  subtotalCentavos Int @default(0)
  discountCentavos Int @default(0)
  totalCentavos    Int @default(0)

  discountType      PharmacyDiscountType @default(none)
  /// The Senior Citizen or PWD ID presented. Required on the receipt and in
  /// the logbook a pharmacy must keep for these sales.
  beneficiaryIdNo   String?
  beneficiaryName   String?
  /// The portion of the total that is VAT-exempt. An SC/PWD sale is exempt in
  /// full; recording it is what makes the BIR return reconcilable.
  vatExemptCentavos Int                  @default(0)

  /// cash | gcash | card | maya
  paymentMethod    String @default(dbgenerated("'cash'"))
  tenderedCentavos Int    @default(0)
  changeCentavos   Int    @default(0)

  status          PharmacySaleStatus @default(completed)
  /// Free-text reference to the prescription presented. Rx items cannot be
  /// sold without one.
  prescriptionRef String?
  soldByStaffId   String?
  voidedByStaffId String?
  voidedAt        DateTime?
  createdAt       DateTime           @default(now())

  pharmacy Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  items    PharmacySaleItem[]
  returns  PharmacyReturn[]

  @@unique([pharmacyId, receiptNumber])
  @@index([pharmacyId, createdAt])
  @@index([pharmacyId, status])
  @@map("pharmacy_sales")
}

/// One line of one sale, against ONE batch.
///
/// A quantity that spans two batches becomes two lines, because which batch a
/// unit came from is the recall trail. Names and prices are snapshotted for the
/// same reason Servd's order items snapshot them.
model PharmacySaleItem {
  id         String  @id @default(uuid())
  pharmacyId String
  saleId     String
  /// Nullable, and SET NULL on delete — NOT Restrict.
  ///
  /// Scar tissue, inherited rather than rediscovered: Servd shipped this exact
  /// column as Restrict and it made a menu item undeletable the moment anyone
  /// had ordered it. See prisma/manual/fix-orderitem-menuitem-setnull.sql. The
  /// line already snapshots nameAtTime and genericAtTime, so a sale keeps its
  /// record without the live product row; Restrict only means a pharmacy can
  /// never tidy a discontinued line out of its catalogue.
  productId  String?
  batchId    String?

  nameAtTime        String
  genericAtTime     String?
  lotNumberAtTime   String?
  expiryAtTime      DateTime?
  quantity          Int
  unitPriceCentavos Int
  lineTotalCentavos Int
  /// Snapshotted from the batch. Margin reporting reads this, never the
  /// batch's current cost.
  unitCostCentavos  Int       @default(0)
  createdAt         DateTime  @default(now())

  sale        PharmacySale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     PharmacyProduct?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  batch       PharmacyBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  returnItems PharmacyReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@index([pharmacyId])
  @@map("pharmacy_sale_items")
}

/// A customer brought something back. A credit note against one sale.
///
/// Separate from a VOID, and the difference is not paperwork. A void says the
/// sale never really happened — rung up twice, wrong customer, cashier error —
/// and it is only available on the same business day, because voiding a receipt
/// from a day already closed off would change a figure that has been reported.
/// A return says the sale happened and is being partly undone; it is its own
/// document, with its own number, available any time.
model PharmacyReturn {
  id           String @id @default(uuid())
  pharmacyId   String
  saleId       String
  /// Gapless per pharmacy, and a SEPARATE series from receipts.
  returnNumber String

  reason        String?
  totalCentavos Int     @default(0)
  /// cash | gcash | card | maya | store_credit
  refundMethod  String  @default(dbgenerated("'cash'"))

  processedByStaffId String?
  createdAt          DateTime @default(now())

  pharmacy Pharmacy             @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  sale     PharmacySale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  items    PharmacyReturnItem[]

  @@unique([pharmacyId, returnNumber])
  @@index([pharmacyId, createdAt])
  @@index([saleId])
  @@map("pharmacy_returns")
}

/// One returned line, against the ORIGINAL SALE LINE.
///
/// `saleItemId` rather than just a product id, and that is the load-bearing
/// part: a sale line names the batch the units actually came from, so a return
/// that points at the line knows the lot. Pointing at the product instead —
/// which is what the system this was derived from does — loses it, and a unit
/// from one lot gets counted back into another. A recall names a lot.
model PharmacyReturnItem {
  id         String  @id @default(uuid())
  pharmacyId String
  returnId   String
  saleItemId String
  productId  String?
  /// Copied from the sale line, so the trail survives even if the batch row
  /// is later removed.
  batchId    String?

  quantity          Int
  unitPriceCentavos Int
  lineTotalCentavos Int
  /// Destroyed by default: a dispensed medicine cannot go back on the shelf.
  disposition       PharmacyReturnDisposition @default(destroyed)

  createdAt DateTime @default(now())

  return   PharmacyReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem PharmacySaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([saleItemId])
  @@index([pharmacyId])
  @@map("pharmacy_return_items")
}

// ---------------------------------------------------------------------------
// CANVEXIA — the public site (apps/www) and the city-partner waitlist.
//
// `public` schema like every other table here. The brief asked for a `core`
// schema; this one has no multiSchema preview feature and no @@schema
// annotations, so a second schema would mean enabling a preview feature and
// annotating all 100 existing models on a live database, for a naming
// preference. Settled: public.
// ---------------------------------------------------------------------------

enum TerritoryTier {
  small
  mid
  large
  /// Davao City. The model territory — not for sale.
  hq
}

enum TerritoryStatus {
  available
  reserved
  taken
  hq
}

enum WaitlistHours {
  under5  @map("<5")
  h5to10  @map("5-10")
  h10to20 @map("10-20")
  h20plus @map("20+")
}

enum WaitlistStatus {
  new
  contacted
  shortlisted
  rejected
  /// Became a partner. The row is KEPT rather than deleted — it is the only
  /// record of where that partner came from, and `convertedPartnerId` makes the
  /// question answerable in one join.
  converted
}

/// A Philippine city a partner can license, and what it costs.
model Territory {
  id         String          @id @default(uuid())
  name       String
  province   String
  region     String
  slug       String          @unique
  tier       TerritoryTier
  /// Pesos, not centavos: a licence fee is quoted in whole pesos and never
  /// arithmetic'd against money columns elsewhere. Storing it in centavos
  /// would invite someone to add it to a centavos total by mistake.
  licenseFee Int
  status     TerritoryStatus @default(available)

  // --- Assignment and splitting (Phase H1) ----------------------------------
  /// The operator licensed for this city, once assigned. The authoritative
  /// answer; `partners.territory` is the free text it has always been.
  partnerId  String?
  /// Set on a child created by a split (Quezon City → its districts).
  parentId   String?
  /// False on a parent that has been split: the districts are for sale, the
  /// whole is not. Default true, so all 143 seeded rows are exactly as
  /// assignable as they were before this column existed.
  assignable Boolean         @default(dbgenerated("true"))
  assignedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waitlist PartnerWaitlist[]

  holder   Partner?  @relation("TerritoryHolder", fields: [partnerId], references: [id], onDelete: SetNull)
  /// Partners whose profile points here. Distinct from `holder`: a partner row
  /// records the territory it was licensed for, and this side of that.
  licensees Partner[] @relation("PartnerTerritory")
  parent   Territory?  @relation("TerritorySplit", fields: [parentId], references: [id], onDelete: SetNull)
  children Territory[] @relation("TerritorySplit")
  assignments TerritoryAssignment[]

  @@index([tier])
  @@index([status])
  @@index([partnerId])
  @@index([parentId])
  @@map("territories")
}

/// Who held a territory, when, and why they stopped.
///
/// APPEND-ONLY, for the same reason the ledger is. "Who had Cebu before this
/// operator and why did they stop" is a question asked during a dispute, which
/// is exactly when a mutable row would have been overwritten. Releasing sets
/// `releasedAt`; it never deletes.
model TerritoryAssignment {
  id          String    @id @default(uuid())
  territoryId String
  partnerId   String
  assignedAt  DateTime  @default(now())
  releasedAt  DateTime?
  /// Required when releasing. A territory taken back with no reason recorded is
  /// the one an operator will contest.
  reason      String?
  actorEmail  String?
  createdAt   DateTime  @default(now())

  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  partner   Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([territoryId])
  @@index([partnerId])
  @@map("territory_assignments")
}

/// A product capability HQ can switch on or off.
///
/// Global in this phase. `partnerId` is nullable and present from the start so
/// that a per-partner flag is a row rather than a migration during a launch —
/// the same reasoning as NotificationPref.messenger.
model FeatureFlag {
  id        String   @id @default(uuid())
  productId String
  key       String
  enabled   Boolean  @default(false)
  /// NULL = the global value for this product. A row WITH a partnerId overrides
  /// it for that partner only. Two partial unique indexes enforce this in the
  /// database, because NULL is not equal to NULL in a plain unique index and one
  /// would happily accept two global rows for the same flag.
  partnerId String?
  note      String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("feature_flags")
}

/// A notice from HQ to its partners.
///
/// SEPARATE from `Announcement`, which is Servd's merchant-facing notice board
/// and keys its read receipts on a staff user. The audience here is partners,
/// the receipt is per partner, and the targeting is a segment. One table whose
/// rows mean different things depending on a column is the thing to avoid.
model HqAnnouncement {
  id           String    @id @default(uuid())
  title        String
  /// Markdown. Rendered by the portal, never through dangerouslySetInnerHTML.
  body         String
  level        String    @default("info")
  /// NULL = every partner. Otherwise `{ tier, status, productId }` — the shape
  /// lives in packages/core. Evaluated in the app, not in the RLS policy: a
  /// policy that parses JSON to decide visibility is one nobody can verify.
  segment      Json?
  scheduledFor DateTime?
  /// Null while a draft. Only published notices are visible to a partner, and
  /// that part IS enforced by the policy.
  publishedAt  DateTime?
  authorEmail  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reads HqAnnouncementRead[]

  @@index([publishedAt])
  @@map("hq_announcements")
}

/// One row per partner per HQ announcement they have seen.
model HqAnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String
  /// Per PARTNER, not per seat: the receipt answers "has Cebu seen this", which
  /// is what HQ is actually asking.
  partnerId      String
  /// Which seat happened to open it. For the audit trail, not for the receipt.
  partnerUserId  String?
  readAt         DateTime @default(now())

  announcement HqAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  partner      Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([announcementId, partnerId])
  @@index([partnerId])
  @@map("hq_announcement_reads")
}

/// One HQ "view as partner" session.
///
/// A ROW rather than only a signed token. A signature cannot be revoked and
/// leaves nothing to audit; this can be killed, listed, and pointed at from the
/// audit log. `usedAt` makes it single-use, `expiresAt` bounds it at 30 minutes,
/// and `readOnly` is stored rather than assumed so that a writable grant — if
/// one is ever justified — is a different value here and not a silent change of
/// meaning for every row already written.
model ImpersonationGrant {
  id           String    @id @default(uuid())
  /// PlatformAdmin.id of the HQ seat that asked.
  hqAdminId    String
  hqAdminEmail String
  partnerId    String
  /// SHA-256 of the token, never the token. A row that can be read back into a
  /// working session turns a database leak into a login.
  tokenHash    String    @unique
  readOnly     Boolean   @default(true)
  expiresAt    DateTime
  usedAt       DateTime?
  endedAt      DateTime?
  revokedAt    DateTime?
  reason       String?
  createdAt    DateTime  @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([hqAdminId])
  @@map("impersonation_grants")
}

/// The editable half of the product registry.
///
/// `packages/core/src/products/registry.ts` stays the source of truth for which
/// products exist and which are `live`. This overlays what HQ may edit on top.
/// A product cannot be created from here on purpose: `live: false` is what stops
/// the portal offering a merchant an account in something that cannot create
/// one, and a database-driven registry could name a product with no adapter
/// behind it.
model ProductSetting {
  /// Matches a key in the registry. A row for an unknown product is ignored on
  /// read — the registry can shrink between a deploy and this being tidied.
  productId String @id
  /// "live" | "beta" | "coming". Presentation only. Whether a merchant can
  /// actually be provisioned is the registry's `live`, which this cannot
  /// override — the code wins.
  status    String @default("coming")
  trainingUrl String?
  /// A REFERENCE, never the credential: "1Password → CANVEXIA → Resceta demo".
  /// Readable by a partner, which is only acceptable because it is a pointer.
  demoAccountRef String?
  /// Whether a new partner gets this product without being asked.
  defaultEnabled Boolean @default(false)
  updatedAt DateTime @updatedAt

  @@map("product_settings")
}

/// What the provider charges for a unit of SMS or email, and CANVEXIA's markup.
///
/// One row per CHANNEL, not per partner: this is a platform-wide commercial
/// decision. Per-partner pricing, if it is ever wanted, is a `partnerId` column
/// added the way feature_flags carries one.
model PassthroughCost {
  channel String @id
  /// Centavos per 1000 units. Per-1000 because a single SMS costs well under a
  /// peso and an integer per-unit cost would round every message to 0 or 1.
  unitCostCentavos Int @default(0)
  /// What CANVEXIA charges on top, as a percentage of the cost.
  marginPct Int @default(0)
  note      String?
  updatedAt DateTime @updatedAt

  @@map("passthrough_costs")
}

/// Units sent, per partner per month.
///
/// A ROLLUP written by whatever sends, not derived on read: `sms_messages` is
/// merchant-scoped with no partner arm, and counting across it for every
/// partner on every page load is a scan that grows forever — while the answer
/// for a closed month never changes.
///
/// The peso figures are NOT stored. They are computed from PassthroughCost at
/// read time, so correcting a rate fixes every open month rather than only the
/// next one.
model PassthroughUsage {
  id        String   @id @default(uuid())
  partnerId String
  /// "2026-06", Asia/Manila — the same key partner_statements uses.
  month     String
  channel   String
  units     Int      @default(0)
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, month, channel])
  @@index([month])
  @@map("passthrough_usage")
}

/// One firing of a scheduled job.
///
/// So the billing screen reads a fact. Inferring the last run from the newest
/// statement's `frozenAt` is wrong in exactly the case that matters: a run that
/// fired and produced nothing looks identical to a run that never fired — and
/// the freeze cron on this project has never once succeeded.
model CronRun {
  id         String    @id @default(uuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  /// Counts and failures as JSON, not prose: this is read by a screen.
  detail     Json?

  @@index([job, startedAt])
  @@map("cron_runs")
}

/// Somebody asking for a city. No fee, no application, no account — a name
/// and a way to reach them, until the partner programme opens.
///
/// NO `anon` POLICY, deliberately. Every write goes through a server action
/// (the brief's own rule: no client-side Supabase writes), so `anon` needs no
/// grant at all and gets none — rls.sql's backstop locks this table to
/// super-admin on sight. That is stronger than the "anon can INSERT only" the
/// brief asked for, and it closes the shape of hole D27 found on
/// prospect_leads rather than mitigating it: names, emails and mobile numbers
/// with the anon key shipping in every browser.
model PartnerWaitlist {
  id String @id @default(uuid())

  fullName String
  email    String
  mobile   String
  /// Typed freely. A city not in `territories` is a real signal — it tells HQ
  /// where demand is — so it is stored as text and mapped later.
  city     String
  province String?

  currentWork  String?
  hoursPerWeek WaitlistHours
  soldBefore   Boolean
  soldWhat     String?
  howHeard     String?

  /// 'www' | 'messenger'. Where the application came from.
  source String         @default(dbgenerated("'www'"))
  status WaitlistStatus @default(new)

  /// Null until HQ maps the free-text city onto a licensed territory.
  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)

  // --- What HQ records against the application (Phase H3) -------------------
  /// HQ's own notes. Never shown to the applicant.
  notes              String?
  contactedAt        DateTime?
  /// Set on conversion. Answers "where did this partner come from" in one join
  /// rather than by matching an email address that may since have changed.
  convertedPartnerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([city, createdAt])
  @@index([status])
  @@index([territoryId])
  @@map("partner_waitlist")
}

/// An email the platform owes somebody.
///
/// A QUEUE, because sending is blocked on one environment variable:
/// CREDENTIALS_ENCRYPTION_KEY is unset on this project, so the Resend
/// credentials cannot even be stored. A conversion that silently sends nothing
/// is worse than one that says so; a conversion that FAILS because email is
/// unconfigured would be worse still. The row is written inside the conversion
/// transaction and a sender drains it the day the key exists.
model OutboundEmail {
  id       String  @id @default(uuid())
  /// A template key, not a rendered body: the copy belongs in code, where it
  /// can change without rewriting rows that have not gone out yet.
  template String
  toEmail  String
  toName   String?
  /// Template variables. NEVER a token or a password — an invite link is
  /// composed by the sender from the invite row, so a leak of this table is not
  /// a leak of anybody's account.
  payload  Json?

  partnerId String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  failedAt  DateTime?
  error     String?
  attempts  Int       @default(0)

  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@map("outbound_emails")
}

// ============================================================================
// Partner Portal A7 — staff, field attendance, targets, commissions.
//
// Every table here is scoped by partnerId AND carries partnerUserId, because
// both boundaries are real: partnerId keeps Davao out of Tagum, partnerUserId
// keeps a salesperson out of a colleague's GPS trail. rls.sql enforces both —
// the only tables in this schema where the seat is also a policy arm.
// ============================================================================

/// One partner's override of one role's answer to one permission.
///
/// OVERRIDES ONLY. A missing row means "use the default in packages/core", not
/// "denied" — so adding a permission key in a later release cannot silently
/// deny it to every partner that was seeded before the key existed.
model PartnerRolePermission {
  partnerId  String
  /// "admin" | "ops_manager" | "sales" | "support". A CHECK enforces the set.
  role       String
  /// A key from packages/core/src/identity/partner-permissions.ts.
  permission String
  allowed    Boolean
  updatedAt  DateTime @default(now()) @updatedAt
  /// The seat that last changed it. For the audit trail, not a foreign key:
  /// the row must survive that seat being deleted.
  updatedBy  String?

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([partnerId, role, permission])
  @@map("partner_role_permissions")
}

/// What a staff member DID — including the things that changed nothing.
///
/// Deliberately not audit_logs. An audit row answers "what changed and who
/// changed it"; half of what the activity tab shows changed nothing at all — a
/// call placed, a visit where the owner was out. Writing those into audit_logs
/// would bury the rows that exist to be reviewed.
model StaffEvent {
  id            String @id @default(uuid())
  partnerId     String
  partnerUserId String
  /// A CHECK enforces the vocabulary; see add-partner-staff.sql §4.
  kind          String

  /// What it was about, when there is one. Product-scoped for merchants,
  /// because a merchant id is unique only within its product (D29).
  subjectType String?
  productId   String?
  subjectId   String?
  detail      Json?

  occurredAt DateTime @default(now())

  partner Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    PartnerUser @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)

  @@index([partnerId, occurredAt])
  @@index([partnerUserId, occurredAt])
  @@map("staff_events")
}

/// One staff member's targets for one month.
model StaffTarget {
  id            String @id @default(uuid())
  partnerId     String
  partnerUserId String
  /// "YYYY-MM". A key, not a date, for the reason PartnerStatement.month is
  /// one: anything derived from an instant lands in the wrong month for the
  /// eight hours a day Manila and UTC disagree.
  month         String

  targetMerchants Int @default(0)
  targetVisits    Int @default(0)
  targetDemos     Int @default(0)

  setByUserId String?
  updatedAt   DateTime @default(now()) @updatedAt

  partner Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    PartnerUser @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)

  @@unique([partnerUserId, month])
  @@index([partnerId, month])
  @@map("staff_targets")
}

/// One day's check-in and check-out for one staff member.
///
/// Shaped after TimeEntry, which does this for a merchant's own restaurant
/// staff. Different axis — that one is scoped by restaurantId — so separate
/// tables, but the open/closed pair and the selfie handling are proven.
model AttendanceSession {
  id            String @id @default(uuid())
  partnerId     String
  partnerUserId String
  /// The MANILA day, computed by the caller. A unique index on
  /// (partnerUserId, dayKey) is what enforces one open session per day; two
  /// taps on a flaky connection is the normal case, not the edge case.
  dayKey        String

  checkInAt       DateTime @default(now())
  checkInLat      Float?
  checkInLng      Float?
  checkInAccuracy Float?
  /// Storage PATH in the private partner-attendance bucket, never a URL.
  checkInPhoto    String?

  checkOutAt       DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutAccuracy Float?
  checkOutPhoto    String?

  /// Set when the 23:59 Manila sweep closed it instead of the person. A day
  /// that was never checked out of is a fact a manager needs, not one to paper
  /// over by writing a plausible time.
  autoClosed Boolean @default(false)
  device     String?
  /// Minted on the device before it has a connection. Unique, so a replayed
  /// sync is a no-op rather than a second session.
  clientRef  String?

  partner Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    PartnerUser @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)

  @@unique([partnerUserId, dayKey])
  @@unique([clientRef])
  @@index([partnerId, dayKey])
  @@map("attendance_sessions")
}

/// A geotagged call on a prospect or a merchant.
model StaffVisit {
  id            String @id @default(uuid())
  partnerId     String
  partnerUserId String

  /// "prospect" | "merchant".
  subjectType String
  /// Set for merchants only — the id is unique only within its product (D29).
  productId   String?
  subjectId   String
  /// Snapshotted so the log still reads after a prospect is deleted.
  subjectName String?

  lat      Float?
  lng      Float?
  accuracy Float?
  /// NULL when the subject has no stored address. The screen says "no address
  /// on file" rather than showing a distance of zero: those are not the same
  /// fact and only one of them is a flag.
  distanceMeters Float?

  /// "met_owner" | "not_available" | "follow_up" | "signed".
  outcome   String
  notes     String?
  photoPath String?

  occurredAt DateTime @default(now())
  /// See AttendanceSession.clientRef.
  clientRef  String?

  partner Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    PartnerUser @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)

  @@unique([clientRef])
  @@index([partnerId, occurredAt])
  @@index([partnerUserId, occurredAt])
  @@map("staff_visits")
}

/// How one staff member is paid on what they sell.
///
/// Several may be active at once — per_signup plus pct_recurring is the
/// ordinary arrangement — so this is a list, not a column on the seat.
model CommissionRule {
  id            String @id @default(uuid())
  partnerId     String
  partnerUserId String

  /// "per_signup" | "pct_first_month" | "pct_recurring" | "none".
  type      String
  /// Centavos for per_signup; BASIS POINTS for the two percentages. An integer
  /// either way: 2.5% stored as 0.025 in a float is how a statement ends up a
  /// centavo short of the sum of its own lines.
  value     Int    @default(0)
  /// "all_products" | "product". A CHECK requires productId with the second
  /// and forbids it with the first.
  appliesTo String @default("all_products")
  productId String?

  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  createdBy String?

  partner Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    PartnerUser @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)

  @@index([partnerUserId])
  @@index([partnerId])
  @@map("commission_rules")
}

/// One staff member's commission for one month, frozen.
///
/// A rule edited in March must not rewrite January, so every line snapshots the
/// rule that produced it. Same reasoning as PartnerLedgerEntry.sharePct.
model CommissionStatement {
  id            String @id @default(uuid())
  partnerId     String
  partnerUserId String
  /// "YYYY-MM".
  month         String

  totalCentavos Int      @default(0)
  frozenAt      DateTime @default(now())

  paidAt        DateTime?
  paidReference String?
  paidBy        String?

  partner Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    PartnerUser      @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)
  lines   CommissionLine[]

  @@unique([partnerUserId, month])
  @@index([partnerId, month])
  @@map("commission_statements")
}

/// One merchant's contribution to one commission statement.
model CommissionLine {
  id          String @id @default(uuid())
  statementId String

  productId    String
  merchantId   String
  merchantName String?

  /// The rule AS IT WAS when the statement froze.
  ruleType  String
  ruleValue Int

  /// What the percentage was taken of. Equal to amountCentavos for per_signup.
  basisCentavos  Int @default(0)
  amountCentavos Int @default(0)

  /// The settlement this line was computed from. Unique per statement, so a
  /// replayed job cannot pay twice.
  ledgerEntryId String?

  statement CommissionStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([statementId, ledgerEntryId])
  @@index([statementId])
  @@map("commission_lines")
}
