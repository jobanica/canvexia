# dependencies
node_modules/
.pnpm-store/

# next.js
.next/

# build output
#
# These are ANCHORED on purpose. The app has real source directories named
# "build" (src/app/build, src/server/build, tests/build, ...), so a bare
# "build/" here would silently ignore new files added under any of them.
/build/
/out/
apps/*/build/
apps/*/out/
packages/*/dist/

# turborepo
.turbo/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — NEVER commit secrets
.env
.env*.local
.env.production

# typescript / next
next-env.d.ts
*.tsbuildinfo

# prisma
**/prisma/*.db

# test
/coverage/
apps/*/coverage/
packages/*/coverage/

# supabase CLI scratch
**/supabase/.temp/

# Vercel CLI link. Never committed: it points a local `vercel` run at one
# specific project, and the one checked in here pointed at a DIFFERENT repo's
# deployment (jobanica/Servd). Each project is linked from the dashboard.
.vercel

# Personal Claude Code overrides for this checkout. Never committed — this
# repository is public, and a permission rule here applies to whoever has it.
.claude/settings.local.json
